#!/bin/bash
# pihole-ha-debug — collect a diagnostics bundle for troubleshooting.
#
#   sudo pihole-ha-debug            # print to screen (copy/paste when asking for help)
#   sudo pihole-ha-debug > ha.txt   # save to a file to attach
#
# Passwords (auth.conf) and Pushover tokens (notify.conf) are redacted.
# Read-only: this collects state, it changes nothing.

CONF_DIR="/etc/pihole-ha"
RUN_DIR="/run/pihole-ha"
SHARE_DIR="/usr/local/share/pihole-ha"

_hr()  { printf '\n===== %s =====\n' "$1"; }
_run() { printf '$ %s\n' "$*"; "$@" 2>&1; printf '\n'; }
_have(){ command -v "$1" >/dev/null 2>&1; }

# Redact secrets from a config file: PASS_*, PO_TOKEN, PO_USER, WEBPASSWORD, api_password
_redact() {
    sed -E \
        -e 's/^(PASS_[^=]*=).*/\1<redacted>/' \
        -e 's/^(PO_TOKEN=).*/\1<redacted>/' \
        -e 's/^(PO_USER=).*/\1<redacted>/' \
        -e 's/([Pp]assword[^=:]*[=:]).*/\1<redacted>/g'
}

printf 'Pi-hole HA diagnostics\n'
printf 'generated: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null)"

_hr "VERSION / HOST"
printf 'pihole-ha version: %s\n' "$(cat "$SHARE_DIR/VERSION" 2>/dev/null || echo unknown)"
printf 'hostname:          %s\n' "$(hostname 2>/dev/null)"
printf 'local IPs:         %s\n' "$(hostname -I 2>/dev/null)"
_have pihole-FTL && printf 'pihole-FTL:        %s\n' "$(pihole-FTL --version 2>/dev/null | head -1)"
printf 'uid:               %s\n' "$(id -u) ($(id -un 2>/dev/null))"
[[ "$(id -u)" -ne 0 ]] && printf '  NOTE: not root — some fields will be blank. Re-run with sudo.\n'

_hr "CONFIG (secrets redacted)"
for f in nodes.conf sync.conf master.conf; do
    printf '%s\n' "--- $f ---"
    [[ -f "$CONF_DIR/$f" ]] && _redact < "$CONF_DIR/$f" || echo "(missing)"
    printf '\n'
done
printf '%s\n' "--- auth.conf (keys only) ---"
[[ -f "$CONF_DIR/auth.conf" ]] && sed -E 's/=.*/=<redacted>/' "$CONF_DIR/auth.conf" || echo "(none)"
printf '\n'; printf '%s\n' "--- notify.conf (redacted) ---"
[[ -f "$CONF_DIR/notify.conf" ]] && _redact < "$CONF_DIR/notify.conf" || echo "(none)"

_hr "SERVICES"
if _have systemctl; then
    for s in pihole-ha pihole-ha-dash pihole-FTL; do
        printf '%-16s %s\n' "$s:" "$(systemctl is-active "$s" 2>/dev/null) / $(systemctl is-enabled "$s" 2>/dev/null)"
    done
else
    echo "(no systemd — Docker deployment? check container logs)"
fi

_hr "CLUSTER STATUS (from this node's daemon)"
if [[ -f "$RUN_DIR/status.json" ]]; then
    if _have python3; then python3 -m json.tool "$RUN_DIR/status.json" 2>/dev/null || cat "$RUN_DIR/status.json"
    else cat "$RUN_DIR/status.json"; fi
else
    echo "(no status.json — daemon may not be running)"
fi

_hr "PI-HOLE DNS / DHCP CONFIG"
if _have pihole-FTL; then
    for k in dns.listeningMode webserver.port dhcp.active dhcp.start dhcp.end dhcp.router; do
        printf '%-26s %s\n' "$k" "$(pihole-FTL --config "$k" 2>/dev/null)"
    done
    printf 'dns.upstreams              %s\n' "$(pihole-FTL --config dns.upstreams 2>/dev/null)"
    printf 'dhcp.hosts (static leases) %s\n' "$(pihole-FTL --config dhcp.hosts 2>/dev/null)"
fi

_hr "VIP / NETWORK (does FTL answer on the VIP?)"
VIP="$(sed -n 's/^VIP=//p' "$CONF_DIR/nodes.conf" 2>/dev/null)"
printf 'configured VIP: %s\n\n' "${VIP:-<none>}"
_run ip -4 addr show
printf 'listeners on :53 (FTL should be bound so it answers on the VIP):\n'
if _have ss; then ss -lntup 2>/dev/null | grep -E ':53\b' || echo "(nothing on :53?!)"
elif _have netstat; then netstat -lntup 2>/dev/null | grep -E ':53\b'; fi
printf '\n'
if _have dig; then
    printf 'dig @127.0.0.1 (local FTL):\n'; dig +short +timeout=3 +tries=1 @127.0.0.1 pi-hole.net A 2>&1 | head -3; printf '\n'
    if [[ -n "$VIP" ]]; then
        printf 'dig @%s (the VIP — if this hangs/fails but 127.0.0.1 works, FTL is not serving the VIP):\n' "$VIP"
        dig +short +timeout=3 +tries=1 @"$VIP" pi-hole.net A 2>&1 | head -3; printf '\n'
    fi
else
    echo "(dig not installed — install dnsutils/bind-tools to test resolution)"
fi

_hr "DNSMASQ FILES pihole-ha MANAGES"
for f in /etc/dnsmasq.d/09-pihole-ha.conf /etc/dnsmasq.d/10-pihole-ha-hook.conf; do
    printf '%s\n' "--- $f ---"; [[ -f "$f" ]] && cat "$f" || echo "(none)"; printf '\n'
done
printf '%s\n' "--- /etc/resolv.conf (this host's own resolver) ---"; cat /etc/resolv.conf 2>/dev/null

_hr "PEER REACHABILITY (:8887 API)"
NODES="$(sed -n 's/^HA_NODES=//p' "$CONF_DIR/nodes.conf" 2>/dev/null | tr ',' ' ')"
for n in $NODES; do
    ip="${n%%:*}"
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 4 "http://$ip:8887/api/status" 2>/dev/null)"
    printf '%-18s /api/status -> %s\n' "$ip" "${code:-no-response}"
done

_hr "CONFIG SYNC STATE"
# Sync problems are the one class where the failing node is usually NOT the one
# the bundle was collected on: the primary builds fine and the standby quietly
# declines to pull. Collect enough here to tell those apart from one bundle.
_sync_primary="$(sed -n 's/^SYNC_PRIMARY=//p' "$CONF_DIR/sync.conf" 2>/dev/null | head -1)"
_nodes_list="$(sed -n 's/^HA_NODES=//p' "$CONF_DIR/nodes.conf" 2>/dev/null | tr ',' ' ')"
# Same default the sync scripts apply when sync.conf omits it.
if [[ -z "$_sync_primary" ]]; then
    _first="$(set -- $_nodes_list; echo "${1:-}")"
    _sync_primary="${_first:+${_first%%:*} (defaulted to first node)}"
    _sync_primary="${_sync_primary:-(unset, and no HA_NODES to default from)}"
fi
_me="$(hostname -I 2>/dev/null | awk '{print $1}')"

printf 'this node:        %s\n' "${_me:-unknown}"
printf 'SYNC_PRIMARY:     %s\n' "${_sync_primary:-（unset)}"
printf 'publisher here?:  %s\n' "$([[ "$_me" == "${_sync_primary%% *}" ]] && echo "yes - this node builds, it never pulls" || echo "no - this node should be pulling")"
printf 'sync role file:   %s\n' "$(cat "$RUN_DIR/sync-role" 2>/dev/null || echo '(none)')"
printf 'config version:   %s\n' "$(cat "$CONF_DIR/sync-version" 2>/dev/null || echo '(none)')"
printf 'generation:       %s\n' "$(cat "$CONF_DIR/sync-generation" 2>/dev/null || echo '(none)')"
printf 'last pulled hash: %s\n' "$(cat "$RUN_DIR/last-pull-hash" 2>/dev/null || echo '(never pulled)')"
if [[ -f "$RUN_DIR/sync-payload.tar.gz" ]]; then
    printf 'local payload:    %s bytes, built %s\n' \
        "$(stat -c%s "$RUN_DIR/sync-payload.tar.gz" 2>/dev/null)" \
        "$(date -r "$RUN_DIR/sync-payload.tar.gz" '+%Y-%m-%dT%H:%M:%S' 2>/dev/null)"
else
    printf 'local payload:    (none built on this node)\n'
fi
if _have systemctl; then
    for t in pihole-ha-sync.timer pihole-ha-sync-pull.timer; do
        # is-active/is-enabled print a verdict AND exit non-zero for anything
        # not running, so "|| echo n/a" appends a second line to the answer
        # rather than replacing a missing one. Take the output, fall back only
        # when it is genuinely empty.
        _a="$(systemctl is-active "$t" 2>/dev/null)"
        _e="$(systemctl is-enabled "$t" 2>/dev/null)"
        printf '%-26s %s / %s\n' "$t" "${_a:-n/a}" "${_e:-n/a}"
    done
fi

# The comparison that actually locates a sync fault: what every node believes it
# is holding. Equal versions and hashes across the cluster means sync is working
# whatever else looks odd; a standby stuck at an older version (or with no
# manifest at all) names the broken node directly.
printf '\ncluster manifest (each node'"'"'s own view, via :8887):\n'
printf '%-18s %-8s %-6s %-34s %s\n' "NODE" "VERSION" "GEN" "HASH" "BUILT"
for n in $_nodes_list; do
    ip="${n%%:*}"
    _man="$(curl -sf --max-time 4 "http://$ip:8887/api/sync/manifest" 2>/dev/null)"
    if [[ -z "$_man" ]]; then
        # A standby that has never published has no manifest, which is normal --
        # saying "broken" here would send people chasing the healthy node. Only
        # an unanswered API is worth flagging.
        if curl -sf --max-time 4 -o /dev/null "http://$ip:8887/api/status" 2>/dev/null; then
            if [[ "$ip" == "${_sync_primary%% *}" ]]; then
                printf '%-18s %s\n' "$ip" "*** NO MANIFEST, BUT THIS IS THE PUBLISHER - nothing to sync from ***"
                printf '%-18s %s\n' "" "   check on $ip: systemctl is-active pihole-ha-sync.timer"
            else
                printf '%-18s %s\n' "$ip" "(no manifest - normal for a standby that has never published)"
            fi
        else
            printf '%-18s %s\n' "$ip" "(UNREACHABLE on :8887)"
        fi
        continue
    fi
    _v="$(printf '%s' "$_man" | sed -n 's/.*"config_version"[: ]*"\?\([^",}]*\)"\?.*/\1/p' | head -1)"
    _h="$(printf '%s' "$_man" | sed -n 's/.*"gravity_md5"[: ]*"\([^"]*\)".*/\1/p' | head -1)"
    _t="$(printf '%s' "$_man" | sed -n 's/.*"timestamp"[: ]*"\([^"]*\)".*/\1/p' | head -1)"
    _g="$(curl -sf --max-time 4 "http://$ip:8887/api/sync/generation" 2>/dev/null | sed -n 's/.*"generation"[: ]*\([0-9]*\).*/\1/p')"
    printf '%-18s %-8s %-6s %-34s %s\n' "$ip" "${_v:--}" "${_g:--}" "${_h:--}" "${_t:--}"
done
printf '\nIf the versions/hashes above differ, the node that is behind is the one to\n'
printf 'look at — run "sudo pihole-ha-sync-pull" there to see the skip reason.\n'

_hr "RECENT LOGS (last 40 lines each)"
if _have journalctl; then
    for s in pihole-ha pihole-ha-dash pihole-ha-sync pihole-ha-sync-pull; do
        printf '%s\n' "--- journalctl -u $s ---"
        journalctl -u "$s" -n 40 --no-pager 2>/dev/null || echo "(no logs)"
        printf '\n'
    done
    printf '%s\n' "--- errors/warnings across pihole-ha units (last 24h) ---"
    journalctl -u pihole-ha -u pihole-ha-dash -u pihole-ha-sync -u pihole-ha-sync-pull \
        --since "24 hours ago" -p warning --no-pager 2>/dev/null | tail -40 || true
else
    echo "(no journalctl — on Docker, use: docker compose logs pihole-ha)"
fi

_hr "END"
printf 'Paste everything above when reporting an issue. Secrets were redacted.\n'
