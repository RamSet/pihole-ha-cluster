#!/bin/bash
# pihole-ha-platform — Platform abstraction layer + shared helpers
# Detects Docker vs bare-metal and provides unified functions
# Source this file from pihole-ha scripts: . /usr/local/lib/pihole-ha/pihole-ha-platform

# Detect platform: Docker if /.dockerenv exists
if [[ -f /.dockerenv ]]; then
    PIHOLE_HA_PLATFORM="docker"
else
    PIHOLE_HA_PLATFORM="systemd"
fi

# Structured logging. Callers may override PIHOLE_HA_LOG_TAG (for syslog
# tagging) and ROLE (printed in each line) before or after sourcing. Both
# have safe defaults; logger is best-effort and never fails the script.
PIHOLE_HA_LOG_TAG="${PIHOLE_HA_LOG_TAG:-pihole-ha}"
_log() {
    local lvl="$1"; shift
    local ts; ts="$(date '+%Y-%m-%dT%H:%M:%S')"
    echo "$ts [${ROLE:-}] [$lvl] $*"
    logger -t "$PIHOLE_HA_LOG_TAG" "[${ROLE:-}] [$lvl] $*" 2>/dev/null || true
}
log_info()  { _log "INFO"  "$*"; }
log_warn()  { _log "WARN"  "$*"; }
log_error() { _log "ERROR" "$*"; }

# Read one field out of a JSON body, whatever whitespace it was printed with.
#
# Pi-hole pretty-prints its whole API when webserver.api.prettyJSON is on, which
# puts a tab between "sid": and its value. Every compact-only match then misses:
# a login that had SUCCEEDED was read as a failure, and the session it created
# was abandoned -- one seat per retry, until that Pi-hole refused every login on
# the cluster and the fault presented as a wrong password. Match the shape of
# JSON, not the way one instance happens to print it.
json_str()  { [[ "$1" =~ \"$2\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]] && printf '%s' "${BASH_REMATCH[1]}"; }
json_num()  { [[ "$1" =~ \"$2\"[[:space:]]*:[[:space:]]*(-?[0-9]+) ]] && printf '%s' "${BASH_REMATCH[1]}"; }
json_bool() { [[ "$1" =~ \"$2\"[[:space:]]*:[[:space:]]*(true|false) ]] && printf '%s' "${BASH_REMATCH[1]}"; }

# IPv4 dotted-quad validator. Returns 0 if $1 is valid, 1 otherwise.
is_valid_ip() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local i; for i in 1 2 3 4; do (( ${BASH_REMATCH[$i]} > 255 )) && return 1; done; return 0
}

# Load Pushover settings from /etc/pihole-ha/notify.conf into globals
# PO_ENABLED / PO_USER / PO_TOKEN / PO_TITLE. Safe when the file is absent.
load_notify_conf() {
    local conf="${1:-/etc/pihole-ha/notify.conf}"
    PO_ENABLED="false"; PO_USER=""; PO_TOKEN=""; PO_TITLE="pihole-ha"; PO_MUTED_TAGS=""
    [[ -f "$conf" ]] || return 0
    local key val
    while IFS='=' read -r key val; do
        [[ -z "$key" || "$key" == \#* ]] && continue
        case "$key" in
            PO_ENABLED) PO_ENABLED="$val" ;;
            PO_USER)    PO_USER="$val" ;;
            PO_TOKEN)   PO_TOKEN="$val" ;;
            PO_TITLE)   PO_TITLE="$val" ;;
            MUTED_TAGS) PO_MUTED_TAGS="$val" ;;
        esac
    done < "$conf"
}

# Read /etc/pihole-ha/sync.conf into the SYNC_* globals.
#
# NOT sourced, deliberately. This file arrives over the network: pihole-ha-sync
# ships it inside the config payload and pihole-ha-sync-pull writes it verbatim,
# so sourcing it ran whatever a peer put in it, as root, on the next timer tick.
# Parse a fixed key whitelist instead and drop any value that is not the shape
# that key is allowed to have.
#
# Unlike load_notify_conf this does NOT reset to defaults first: every caller
# sets its own defaults and relies on an absent key leaving them untouched.
load_sync_conf() {
    local conf="${1:-/etc/pihole-ha/sync.conf}"
    [[ -f "$conf" ]] || return 0
    local key val
    # `|| [[ -n "$key" ]]`: read returns non-zero on a final line with no
    # trailing newline, which would silently drop the last entry.
    while IFS='=' read -r key val || [[ -n "$key" ]]; do
        [[ -z "$key" || "$key" == \#* ]] && continue
        val="${val%$'\r'}"
        case "$key" in
            SYNC_ENABLED|SYNC_GRAVITY|SYNC_DHCP|SYNC_DNS|SYNC_SETTINGS|SYNC_NOTIFY)
                # printf -v is safe here: $key can only be one of the literals above.
                [[ "$val" == "true" || "$val" == "false" ]] && printf -v "$key" '%s' "$val" ;;
            SYNC_INTERVAL)
                # 10# or a zero-padded value like 08 is read as invalid octal.
                [[ "$val" =~ ^[0-9]+$ ]] && (( 10#$val >= 1 && 10#$val <= 1440 )) && SYNC_INTERVAL="$val" ;;
            SYNC_PRIMARY)
                is_valid_ip "$val" && SYNC_PRIMARY="$val" ;;
        esac
    done < "$conf"
}

# Per-kind mute helper. Returns 0 (muted) when $1 is a non-empty tag that
# appears in PO_MUTED_TAGS (comma-separated). Untagged calls always pass.
# Relies on the caller having loaded notify.conf this run; the daemon
# re-reads it each loop so a dashboard toggle takes effect within seconds.
_notify_tag_muted() {
    local tag="${1:-}"
    [[ -z "$tag" ]] && return 1
    [[ -z "${PO_MUTED_TAGS:-}" ]] && return 1
    local IFS=',' t
    for t in $PO_MUTED_TAGS; do
        t="${t# }"; t="${t% }"
        [[ "$t" == "$tag" ]] && return 0
    done
    return 1
}

# Send a Pushover notification (synchronous). Resolves api.pushover.net
# via local Pi-hole, then any peers in ${NODES[@]}, then system resolver,
# so notifications keep working during failover when local DNS is flapping.
# Callers in long-running daemons should background with `notify "..." &`.
notify() {
    # Usage: notify "<message...>"
    # The entire argument list is sent as the message (see "message=$*"
    # below) so a mis-quoted or word-split value can never be truncated.
    # To enable per-kind mute, set NOTIFY_TAG in the call's environment:
    #     NOTIFY_TAG=vip_claim_failed notify "..."
    # The tag is carried out-of-band, never as a positional argument, so it
    # cannot be smuggled into (or truncate) the message. If NOTIFY_TAG is in
    # PO_MUTED_TAGS the send is silently dropped; untagged callers always fire.
    local _tag="${NOTIFY_TAG:-}"; NOTIFY_TAG=""
    if _notify_tag_muted "$_tag"; then
        command -v log_info >/dev/null 2>&1 && log_info "event=notify_muted tag=$_tag"
        return 0
    fi
    [[ "$PO_ENABLED" == "true" && -n "$PO_USER" && -n "$PO_TOKEN" ]] || return 0
    local po_ip="" src="" peer
    po_ip="$(dig +short +timeout=2 +tries=1 @127.0.0.1 api.pushover.net A 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | tail -1)"
    [[ -n "$po_ip" ]] && src="local"
    if [[ -z "$po_ip" && -n "${NODES[*]:-}" ]]; then
        for peer in "${NODES[@]}"; do
            [[ "$peer" == "${LOCAL_IP:-}" ]] && continue
            po_ip="$(dig +short +timeout=2 +tries=1 @"$peer" api.pushover.net A 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | tail -1)"
            [[ -n "$po_ip" ]] && src="peer:$peer" && break
        done
    fi
    if [[ -z "$po_ip" ]]; then
        po_ip="$(dig +short +timeout=2 +tries=1 api.pushover.net A 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | tail -1)"
        [[ -n "$po_ip" ]] && src="system"
    fi
    if [[ -z "$po_ip" ]]; then
        command -v log_warn >/dev/null 2>&1 && log_warn "event=notify_dns_failed host=api.pushover.net"
        return 0
    fi
    command -v log_info >/dev/null 2>&1 && log_info "event=notify_sending dns_src=$src resolved=$po_ip"
    curl -s --max-time 10 \
        --resolve "api.pushover.net:443:$po_ip" \
        -X POST "https://api.pushover.net/1/messages.json" \
        -d "token=$PO_TOKEN" -d "user=$PO_USER" \
        -d "html=1" -d "title=$PO_TITLE" \
        --data-urlencode "message=$*" >/dev/null 2>&1
}

platform_get_local_ip() {
    local _all _ip _nodes _vip
    # hostname -I works on Debian/Ubuntu but not Alpine BusyBox
    if hostname -I &>/dev/null; then
        _all="$(hostname -I 2>/dev/null)"
    else
        # Fallback: use ip route to find the source IP for default route
        _all="$(ip -o route get 1.0.0.0 2>/dev/null | sed -n 's/.*src \([^ ]*\).*/\1/p')"
    fi

    # A node holding the VIP has two addresses on the interface, and `hostname -I`
    # guarantees no ordering -- so taking the first can hand back the VIP. That
    # matches no entry in HA_NODES, and every caller then dies with "Unknown IP",
    # taking the daemon, the sync build and the sync pull down together on the
    # one node that was healthy enough to hold the VIP. Prefer whichever local
    # address is actually a cluster member.
    _nodes="$(sed -n 's/^HA_NODES=//p' /etc/pihole-ha/nodes.conf 2>/dev/null | tr ',' ' ')"
    if [[ -n "$_nodes" ]]; then
        for _ip in $_all; do
            for _n in $_nodes; do
                [[ "$_ip" == "${_n%%:*}" ]] && { printf '%s' "$_ip"; return 0; }
            done
        done
    fi
    # Not a configured member (fresh install, or the list was edited): still
    # avoid the VIP, which is never a node identity.
    _vip="$(sed -n 's/^VIP=//p' /etc/pihole-ha/nodes.conf 2>/dev/null | head -1)"
    for _ip in $_all; do
        [[ -n "$_vip" && "$_ip" == "$_vip" ]] && continue
        printf '%s' "$_ip"; return 0
    done
    printf '%s' "${_all%% *}"
}

platform_ftl_is_active() {
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        pgrep -x pihole-FTL >/dev/null 2>&1
    else
        systemctl is-active --quiet pihole-FTL
    fi
}

# Read / write Pi-hole's DHCP server state.
#
# Both deployments drive pihole-FTL directly, but this lives here so callers
# don't each hardcode the binary: the daemon and the dashboard both need to
# stand DHCP down, and a bare call that silently no-ops when pihole-FTL isn't
# on PATH would leave a node serving DHCP when it was told to stop.
# Returns non-zero if pihole-FTL is unavailable so callers can report it.
platform_get_dhcp() {
    command -v pihole-FTL >/dev/null 2>&1 || { echo "false"; return 1; }
    pihole-FTL --config dhcp.active 2>/dev/null || { echo "false"; return 1; }
}

platform_set_dhcp() {
    local want="$1"
    command -v pihole-FTL >/dev/null 2>&1 || return 1
    pihole-FTL --config dhcp.active "$want" >/dev/null 2>&1
}

platform_ftl_restart() {
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        # Reload in place -- never SIGTERM. In Docker, FTL is the pihole
        # container's main process, and this sidecar shares that container's PID
        # and network namespaces (pid: "service:pihole" in docker-compose.yml).
        # Stopping FTL therefore stops the pihole container, which tears down the
        # namespace and SIGKILLs whatever is running here -- including the
        # sync-pull that asked for the restart, killed before it can record the
        # hash it just applied. The node then looks stale forever, re-pulls, and
        # kills itself again every cycle: a crash loop that also leaves the
        # sidecar dead when Docker cannot rejoin a still-restarting namespace.
        # SIGHUP makes FTL re-read pihole.toml and reload gravity.db in place,
        # same PID, container untouched. Settings that genuinely need a full
        # restart (listening ports, cache size) are picked up the next time the
        # container restarts on its own.
        local pid
        pid="$(pgrep -x pihole-FTL 2>/dev/null)" || return 1
        kill -HUP "$pid" 2>/dev/null || return 1
        sleep 2
        # Still the same live process? Then the reload landed.
        kill -0 "$pid" 2>/dev/null && return 0
        return 1
    else
        systemctl restart pihole-FTL
    fi
}

# A timer can be active and still never fire again. systemd calls that state
# "elapsed": no trigger is left to wait on -- e.g. a timer holding only
# OnUnitActiveSec= after a reboot, which counts from a service run that has not
# happened yet. `is-active` answers "active" for it all the same, which is how
# issue #7 went unnoticed on both nodes.
_sync_timer_elapsed() {
    [[ "$(systemctl show -p SubState --value "$1" 2>/dev/null)" == "elapsed" ]]
}

# Start a sync timer so that it will actually fire. Running the service once
# gives OnUnitActiveSec= the anchor it counts from, re-arming an elapsed timer.
_sync_timer_start() {
    systemctl start "$1.timer" 2>/dev/null || true
    if _sync_timer_elapsed "$1.timer"; then
        systemctl start --no-block "$1.service" 2>/dev/null || true
    fi
}

platform_sync_enable() {
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        touch /run/pihole-ha/sync-enabled
    else
        _sync_timer_start pihole-ha-sync
    fi
}

platform_sync_disable() {
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        rm -f /run/pihole-ha/sync-enabled
    else
        systemctl stop pihole-ha-sync.timer 2>/dev/null || true
    fi
}

platform_sync_pull_enable() {
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        touch /run/pihole-ha/sync-pull-enabled
    else
        _sync_timer_start pihole-ha-sync-pull
    fi
}

# Is the role's timer actually running? The role bookkeeping below is only
# believed state; these report the real thing -- active AND due to fire again.
platform_sync_is_running() {
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        [[ -f /run/pihole-ha/sync-enabled ]]
    else
        systemctl is-active --quiet pihole-ha-sync.timer 2>/dev/null &&
            ! _sync_timer_elapsed pihole-ha-sync.timer
    fi
}

platform_sync_pull_is_running() {
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        [[ -f /run/pihole-ha/sync-pull-enabled ]]
    else
        systemctl is-active --quiet pihole-ha-sync-pull.timer 2>/dev/null &&
            ! _sync_timer_elapsed pihole-ha-sync-pull.timer
    fi
}

platform_sync_pull_disable() {
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        rm -f /run/pihole-ha/sync-pull-enabled
    else
        systemctl stop pihole-ha-sync-pull.timer 2>/dev/null || true
    fi
}

platform_sync_set_interval() {
    local minutes="${1:-15}"
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        # Nothing to write: there is no timer unit to reconfigure. The container
        # supervisor re-reads SYNC_INTERVAL from sync.conf every cycle and picks
        # the new value up on its own. (It genuinely does now -- this branch sat
        # empty behind that same claim while the supervisor only ever read the
        # environment, so the panel's interval was ignored on Docker.)
        :
    else
        # Write systemd timer drop-ins for both sync and sync-pull.
        # The empty assignment is the only way to replace the unit's interval,
        # but systemd reads it as "reset EVERY trigger", so it also erased the
        # unit's OnActiveSec= -- the one trigger that does not need the service
        # to have run already. Changing the interval once left both timers
        # active but dead after the next reboot (issue #7). Carry every other
        # trigger the unit declares back in after the reset.
        for unit in pihole-ha-sync.timer pihole-ha-sync-pull.timer; do
            local dir="/etc/systemd/system/${unit}.d" keep
            keep="$(grep -E '^On[A-Za-z]+=' "/etc/systemd/system/$unit" 2>/dev/null | grep -v '^OnUnitActiveSec=' || true)"
            mkdir -p "$dir"
            cat > "$dir/interval.conf" <<EOF
[Timer]
OnUnitActiveSec=
${keep}
OnUnitActiveSec=${minutes}min
EOF
        done
        systemctl daemon-reload 2>/dev/null || true
        # Restart active timers to pick up new interval
        systemctl try-restart pihole-ha-sync.timer 2>/dev/null || true
        systemctl try-restart pihole-ha-sync-pull.timer 2>/dev/null || true
    fi
}

platform_ha_daemon_restart() {
    if [[ "$PIHOLE_HA_PLATFORM" == "docker" ]]; then
        touch /run/pihole-ha/restart-requested
    else
        systemctl restart pihole-ha 2>/dev/null || true
    fi
}
