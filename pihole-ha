#!/bin/bash
# pihole-ha — Pi-hole DHCP failover monitor
# 3-check health: ping + DNS:53 + Pi-hole API DHCP status
# Writes status JSON for dashboard, sends Pushover on state changes

set -uo pipefail

# --- Management CLI dispatch -------------------------------------------------
# This binary is both the failover daemon and the global `pihole-ha` command.
# systemd and Docker launch it bare with no controlling TTY (or as `daemon`),
# which runs the failover loop below. A subcommand — or a bare run in an
# interactive terminal — hands off to the CLI instead, so `pihole-ha update`,
# `status`, etc. work from anywhere.
case "${1:-}" in
    daemon) shift ;;                                   # explicit: run the daemon
    "")     [[ -t 1 ]] && exec /usr/local/lib/pihole-ha/pihole-ha-cli help ;;  # bare+TTY → help; bare+no TTY (systemd/Docker) → daemon
    *)      exec /usr/local/lib/pihole-ha/pihole-ha-cli "$@" ;;                 # any subcommand → CLI
esac
# ----------------------------------------------------------------------------

# Load platform abstraction (systemd vs Docker)
for _p in /usr/local/lib/pihole-ha/pihole-ha-platform ./pihole-ha-platform; do
    [[ -f "$_p" ]] && { . "$_p"; break; }
done

# Load node config (with backwards-compatible defaults)
NODES_CONF="/etc/pihole-ha/nodes.conf"
GATEWAY="" VIP="" VIP_ENABLED="" HA_ENABLED="" HA_NODES="" DHCP_HA=""
[[ -f "$NODES_CONF" ]] && . "$NODES_CONF"
EXPECTED_CONFIG_VERSION=1
CONFIG_VERSION="${CONFIG_VERSION:-0}"
if [[ -z "$GATEWAY" || -z "$HA_NODES" ]]; then
    echo "ERROR: /etc/pihole-ha/nodes.conf missing or incomplete (need GATEWAY and HA_NODES)" >&2
    exit 1
fi
VIP_ENABLED="${VIP_ENABLED:-true}"
HA_ENABLED="${HA_ENABLED:-true}"
# DHCP_HA=false => DNS-only deployment: this node's Pi-hole is not the DHCP
# server, so never manage dhcp.active/VIP; just monitor peers and sync config.
DHCP_HA="${DHCP_HA:-true}"
# PIN_DNS=false => leave this host's system resolver alone. Default true pins it
# to 127.0.0.1 (local Pi-hole) so the node always resolves independent of the VIP.
PIN_DNS="${PIN_DNS:-true}"
# Parse HA_NODES: supports IP or IP:PORT (default port 80)
IFS=',' read -ra _RAW_NODES <<< "$HA_NODES"
NODES=()
declare -A NODE_PORTS
for _rn in "${_RAW_NODES[@]}"; do
    if [[ "$_rn" == *:* ]]; then
        NODES+=("${_rn%%:*}")
        NODE_PORTS["${_rn%%:*}"]="${_rn##*:}"
    else
        NODES+=("$_rn")
        NODE_PORTS["$_rn"]=80
    fi
done
_ROLE_NAMES=("PRIMARY" "SECONDARY" "TERTIARY")
NODE_COUNT=${#NODES[@]}
ROLES=()
for (( _ri=0; _ri<NODE_COUNT; _ri++ )); do
    if (( _ri < ${#_ROLE_NAMES[@]} )); then
        ROLES+=("${_ROLE_NAMES[$_ri]}")
    else
        ROLES+=("NODE$((_ri+1))")
    fi
done
# A node with no peers isn't the PRIMARY of anything — reporting it as such
# makes a node that left the cluster look like it took charge of one.
(( NODE_COUNT == 1 )) && ROLES=("STANDALONE")

IFACE="$(ip -o route get "$GATEWAY" 2>/dev/null | sed -n 's/.*dev \([^ ]*\).*/\1/p')"
[[ -z "$IFACE" ]] && IFACE="$(ip -o link show up | grep -v lo | head -1 | awk -F': ' '{print $2}')"

# Failover timing — override any of these in nodes.conf to tune speed vs. stability.
# A standby takes over after ACTIVATE_AFTER consecutive failed checks, so
# failover time ≈ CHECK_INTERVAL × ACTIVATE_AFTER. Lower = faster failover;
# higher = more tolerant of a transient blip (a one-cycle glitch won't fail over).
CHECK_INTERVAL="${CHECK_INTERVAL:-10}"     # seconds between peer health-check rounds
DEACTIVATE_AFTER="${DEACTIVATE_AFTER:-3}"  # consecutive healthy checks before yielding back
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-2}"      # per-check timeout (ping/DNS/API)
# Authentication is NOT a health check and must not share its timeout. Pi-hole v6
# hashes the app password with a deliberately memory-hard function, so a single
# POST /api/auth can take many seconds on modest hardware — measured in the field
# at 6.4s and 8.7s on a 1-core/512MB Pi, against a timeout that used to be a
# hardcoded 3s. The result was an auth that could never succeed: no session was
# ever cached, so every node re-authenticated to every peer every CHECK_INTERVAL,
# each attempt costing the peer another full password hash. That pegs a small Pi,
# which makes the hash slower still, and the cluster never recovers — peers read
# as denied, config sync stops, and Pi-hole eventually reports "API seats
# exceeded". A passwordless Pi-hole answers the same call in 0.0001s, which is
# why this only ever bit password-protected clusters.
AUTH_TIMEOUT="${AUTH_TIMEOUT:-10}"         # how long to allow for a password hash
AUTH_RETRY_SEC="${AUTH_RETRY_SEC:-60}"     # after a failed auth, wait this long before trying again
_ACTIVATE_BASE="${ACTIVATE_AFTER:-2}"      # base down-checks before a standby takes over
STATUS_DIR="/run/pihole-ha"
STATUS_FILE="$STATUS_DIR/status.json"
SYNC_CONF="/etc/pihole-ha/sync.conf"
GEN_FILE="/etc/pihole-ha/sync-generation"          # persistent pull-generation counter (legacy)
VER_FILE="/etc/pihole-ha/sync-version"             # content-version: advances only on real config changes
SYNC_ROLE_FILE="$STATUS_DIR/sync-role"             # PUBLISHER | STANDBY (for the dashboard)

LOCAL_IP="$(platform_get_local_ip)"

MY_IDX=-1
for (( i=0; i<NODE_COUNT; i++ )); do
    [[ "$LOCAL_IP" == "${NODES[$i]}" ]] && { MY_IDX=$i; break; }
done
[[ $MY_IDX -lt 0 ]] && { echo "Unknown IP: $LOCAL_IP" >&2; exit 1; }

PRIORITY=$((MY_IDX + 1))
ROLE="${ROLES[$MY_IDX]}"

# Staggered activation: primary=immediate, last node waits an extra 2 checks so
# it can't grab at the same instant as a higher-priority standby, others=base.
if (( MY_IDX == 0 )); then
    ACTIVATE_AFTER=0
elif (( MY_IDX == NODE_COUNT - 1 && NODE_COUNT > 2 )); then
    ACTIVATE_AFTER=$(( _ACTIVATE_BASE + 2 ))
else
    ACTIVATE_AFTER=$_ACTIVATE_BASE
fi

mkdir -p "$STATUS_DIR"

# Detect and auto-restart pihole-FTL if it crashes
FTL_LAST_RESTART=0
ensure_ftl_running() {
    platform_ftl_is_active && return 0
    local now
    now="$(date +%s)"
    if (( now - FTL_LAST_RESTART < 30 )); then
        return 1
    fi
    log_warn "event=ftl_down action=restart"
    platform_ftl_restart 2>/dev/null || true
    FTL_LAST_RESTART="$now"
    sleep 2
    if platform_ftl_is_active; then
        log_info "event=ftl_restart status=ok"
        return 0
    fi
    log_error "event=ftl_restart status=failed"
    return 1
}

declare -i activate_count=0 deactivate_count=0 stable_count=0
declare -A peer_ping peer_dns peer_api peer_dhcp peer_leases peer_clients peer_auth
declare -A peer_password peer_sid peer_auth_warned peer_auth_next peer_auth_why peer_needs_pass
_auth_conf_mtime=""   # detects a SAVE even when the value is unchanged

# Load per-node Pi-hole API passwords (for password-protected instances)
# Format: PASS_10_33_47_5=secretpass (dots replaced with underscores)
AUTH_CONF="/etc/pihole-ha/auth.conf"
load_auth() {
    # Runs every loop, so it is also where a password CHANGE is noticed. A new
    # password is new information: it must clear that peer's retry backoff and
    # cached session immediately, or the operator saves the fix in the panel and
    # watches the Auth row sit there for up to AUTH_RETRY_SEC while the daemon
    # honours a backoff from the old, wrong password. Cleared per peer, not
    # wholesale — otherwise reloading every CHECK_INTERVAL would defeat the
    # backoff entirely and put us back to re-hashing on every round.
    local -A _was=()
    local _k
    for _k in "${!peer_password[@]}"; do _was[$_k]="${peer_password[$_k]}"; done
    # A SAVE, not just a changed value, must force a fresh attempt. Re-entering the
    # same password is what an operator does to mean "try again now", and comparing
    # values alone made that a silent no-op: same value, backoff intact, warning
    # already emitted, nothing in the log. mtime moves on every save regardless.
    local _mtime; _mtime="$(stat -c %Y "$AUTH_CONF" 2>/dev/null || echo 0)"
    if [[ "$_mtime" != "${_auth_conf_mtime:-}" ]]; then
        _auth_conf_mtime="$_mtime"
        peer_auth_next=(); peer_auth_warned=()
    fi
    peer_password=()
    [[ -f "$AUTH_CONF" ]] || return
    while IFS='=' read -r key val; do
        [[ "$key" =~ ^PASS_ ]] || continue
        local ip="${key#PASS_}"
        ip="${ip//_/.}"
        peer_password[$ip]="$val"
        if [[ "${_was[$ip]:-}" != "$val" ]]; then
            unset "peer_auth_next[$ip]" "peer_auth_why[$ip]" "peer_sid[$ip]" "peer_auth_warned[$ip]"
        fi
    # `|| [[ -n "$key" ]]`: read returns non-zero on a final line with no trailing
    # newline, which made the loop exit BEFORE processing it — the last entry in
    # auth.conf was silently dropped. The panel always writes a newline, so this
    # only bit hand-edited files, and it failed as "no password stored for that
    # peer" with the file plainly showing one.
    done < <(cat "$AUTH_CONF"; echo)
}
load_auth

# Load DHCP master override config (auto = priority-based, IP = forced master)
MASTER_CONF="/etc/pihole-ha/master.conf"
DHCP_MASTER="auto"
load_master() {
    DHCP_MASTER="auto"
    [[ -f "$MASTER_CONF" ]] || return
    while IFS='=' read -r key val; do
        [[ "$key" == "DHCP_MASTER" ]] && DHCP_MASTER="$val"
    done < "$MASTER_CONF"
}
load_master

# Reload VIP settings from nodes.conf (picks up changes from config sync)
# Returns 0 if VIP config changed, 1 if unchanged
reload_vip_conf() {
    [[ -f "$NODES_CONF" ]] || return 1
    local prev_vip="$VIP" prev_ve="$VIP_ENABLED" prev_nodes="$HA_NODES"
    while IFS='=' read -r key val; do
        val="${val#\"}"; val="${val%\"}"  # strip surrounding quotes
        val="${val#\'}"; val="${val%\'}"
        case "$key" in
            VIP)         VIP="$val" ;;
            VIP_ENABLED) VIP_ENABLED="$val" ;;
            HA_ENABLED)  HA_ENABLED="$val" ;;
            DHCP_HA)     DHCP_HA="$val" ;;
            HA_NODES)    HA_NODES="$val" ;;
        esac
    done < "$NODES_CONF"
    # Rebuild node array if order changed
    if [[ "$HA_NODES" != "$prev_nodes" ]]; then
        # Re-parse with the same IP:PORT handling as startup, else :PORT suffixes
        # leak into NODES and every peer (including self) looks unreachable.
        IFS=',' read -ra _RAW_NODES <<< "$HA_NODES"
        NODES=()
        for _rn in "${_RAW_NODES[@]}"; do
            if [[ "$_rn" == *:* ]]; then
                NODES+=("${_rn%%:*}")
                NODE_PORTS["${_rn%%:*}"]="${_rn##*:}"
            else
                NODES+=("$_rn")
                NODE_PORTS["$_rn"]=80
            fi
        done
        NODE_COUNT=${#NODES[@]}
        # ROLES must be rebuilt too, not just re-indexed: a membership change
        # can shrink the cluster, and the stale array would keep reporting
        # PRIMARY on a node that now has no peers.
        ROLES=()
        for (( _ri=0; _ri<NODE_COUNT; _ri++ )); do
            if (( _ri < ${#_ROLE_NAMES[@]} )); then ROLES+=("${_ROLE_NAMES[$_ri]}"); else ROLES+=("NODE$((_ri+1))"); fi
        done
        (( NODE_COUNT == 1 )) && ROLES=("STANDALONE")
        for i in "${!NODES[@]}"; do
            [[ "${NODES[$i]}" == "$LOCAL_IP" ]] && { MY_IDX=$i; break; }
        done
        PRIORITY=$((MY_IDX + 1))
        ROLE="${ROLES[$MY_IDX]:-UNKNOWN}"
        # Recalculate staggered activation delay
        if (( MY_IDX == 0 )); then
            ACTIVATE_AFTER=0
        elif (( MY_IDX == NODE_COUNT - 1 && NODE_COUNT > 2 )); then
            ACTIVATE_AFTER=4
        else
            ACTIVATE_AFTER=2
        fi
        log_info "event=priority_change nodes=\"${NODES[*]}\" role=$ROLE priority=$PRIORITY"
    fi
    [[ "$VIP" != "$prev_vip" || "$VIP_ENABLED" != "$prev_ve" || "$HA_NODES" != "$prev_nodes" ]]
}

# _log/log_info/log_warn/log_error live in pihole-ha-platform. Default
# PIHOLE_HA_LOG_TAG is "pihole-ha", which is what this daemon wants.

# is_valid_ip() is provided by pihole-ha-platform sourced above.

# Validate all node IPs at startup
for _vip in "${NODES[@]}"; do
    is_valid_ip "$_vip" || { echo "Invalid node IP: $_vip" >&2; exit 1; }
done
is_valid_ip "$GATEWAY" || { echo "Invalid gateway IP: $GATEWAY" >&2; exit 1; }

# Enforce: this node's own DNS must NOT depend on the VIP. If resolv.conf
# points only at the VIP, when this node holds the VIP and dies, surviving
# peers can't resolve anything — including pushover.net for failover alerts.
# Re-pin every startup so reboots that pick up DHCP-supplied DNS self-heal.
# Skipped entirely when the user opted out with PIN_DNS=false — we never touch
# their resolver, and updates preserve that (PIN_DNS lives in nodes.conf).
enforce_dns_pin() {
    [[ "$PIN_DNS" != "true" ]] && return 0
    local first_ns
    first_ns="$(grep -E '^nameserver[[:space:]]+' /etc/resolv.conf 2>/dev/null | head -1 | awk '{print $2}')"
    [[ "$first_ns" == "127.0.0.1" ]] && return 0

    # Only hand this host's DNS to the local resolver once it is actually
    # answering. Pinning to a dead 127.0.0.1 does not degrade resolution, it
    # removes it: the node can then resolve nothing at all. On a fresh container
    # that is a hard deadlock -- FTL has not come up because gravity is still
    # downloading its blocklists, and gravity cannot download them because we
    # just took away the only working resolver, so startup stalls at "DNS
    # resolution is currently unavailable" forever. Deferring costs nothing:
    # the main loop re-runs this every CHECK_INTERVAL, so the pin lands on the
    # first cycle after FTL starts listening.
    if ! nc -z -w1 127.0.0.1 53 >/dev/null 2>&1; then
        log_warn "event=dns_pin_deferred reason=\"local resolver not answering yet — leaving ${first_ns:-existing} resolver in place\""
        return 0
    fi

    log_warn "event=dns_pin_repair first_nameserver=${first_ns:-none} action=repinning"

    # NetworkManager: pin DNS on every active non-loopback connection
    if command -v nmcli &>/dev/null; then
        while IFS= read -r nm_con; do
            [[ -z "$nm_con" ]] && continue
            nmcli con mod "$nm_con" ipv4.dns "127.0.0.1" ipv4.ignore-auto-dns yes 2>/dev/null || true
            nmcli con up "$nm_con" >/dev/null 2>&1 || true
        done < <(nmcli -t -f NAME,DEVICE con show --active 2>/dev/null | grep -v ':lo$' | cut -d: -f1)
    fi

    # systemd-resolved drop-in (idempotent)
    if systemctl is-active systemd-resolved &>/dev/null; then
        mkdir -p /etc/systemd/resolved.conf.d
        cat > /etc/systemd/resolved.conf.d/pihole-ha.conf <<'RESOLVED'
[Resolve]
DNS=127.0.0.1
Domains=~.
DNSStubListener=no
RESOLVED
        systemctl restart systemd-resolved 2>/dev/null || true
    fi

    # Final guarantee: write /etc/resolv.conf directly
    [[ -L /etc/resolv.conf ]] && rm -f /etc/resolv.conf
    chattr -i /etc/resolv.conf 2>/dev/null || true
    cat > /etc/resolv.conf <<'RESOLV'
# pihole-ha: pin DNS to local FTL (do not edit — managed by pihole-ha)
nameserver 127.0.0.1
options edns0 trust-ad
RESOLV

    log_info "event=dns_pin_repaired nameserver=127.0.0.1"
}
enforce_dns_pin

if [[ "$CONFIG_VERSION" -ne "$EXPECTED_CONFIG_VERSION" ]]; then
    log_warn "event=config_version_mismatch found=$CONFIG_VERSION expected=$EXPECTED_CONFIG_VERSION"
fi

# Manage dnsmasq DHCP options advertised to clients
# VIP enabled:  DNS=VIP only, DHCP server-id=VIP
# VIP disabled: DNS=all node IPs, no server-id override
DNSMASQ_HA="/etc/dnsmasq.d/09-pihole-ha.conf"
build_dns_option() {
    local lines=""
    if [[ "$VIP_ENABLED" == "true" && -n "$VIP" ]]; then
        # VIP mode: single VIP as DNS + DHCP server identifier
        lines="dhcp-option=6,$VIP"$'\n'"dhcp-option=54,$VIP"
    else
        # No VIP: all node IPs as DNS, no server-id override
        local dns_list=""
        for ip in "${NODES[@]}"; do
            [[ -n "$dns_list" ]] && dns_list+=","
            dns_list+="$ip"
        done
        lines="dhcp-option=6,$dns_list"
    fi
    echo "$lines"
}
ensure_dns_option() {
    # DNS-only deployment: we don't manage DHCP, so never write DHCP options.
    [[ "$DHCP_HA" != "true" ]] && return 0
    local want header full
    want="$(build_dns_option)"
    header="# pihole-ha: DHCP options for clients"
    full="$(printf '%s\n%s\n' "$header" "$want")"
    if [[ -f "$DNSMASQ_HA" ]] && [[ "$(cat "$DNSMASQ_HA")" == "$full" ]]; then
        return
    fi
    printf '%s\n' "$full" > "$DNSMASQ_HA"
    # Rate-limit FTL restarts to avoid DHCP disruption
    local now; now="$(date +%s)"
    if (( now - FTL_LAST_RESTART < 30 )); then
        log_info "event=dns_option_update options=\"$want\" ftl=deferred"
        return
    fi
    platform_ftl_restart 2>/dev/null || true
    FTL_LAST_RESTART="$now"
    log_info "event=dns_option_update options=\"$want\" ftl=restarted"
}
# Ensure Pi-hole's built-in multiDNS is off (we manage dhcp-option=6 ourselves)
if command -v pihole-FTL &>/dev/null; then
    _multi="$(pihole-FTL --config dhcp.multiDNS 2>/dev/null)"
    if [[ "$_multi" == "true" ]]; then
        pihole-FTL --config dhcp.multiDNS false &>/dev/null
        log_info "event=multidns_disabled reason=\"conflicts with $DNSMASQ_HA\""
    fi
fi
# Remove stale vip-dns.conf if it exists (legacy)
[[ -f /etc/dnsmasq.d/vip-dns.conf ]] && rm -f /etc/dnsmasq.d/vip-dns.conf && log_info "event=cleanup file=/etc/dnsmasq.d/vip-dns.conf"
ensure_dns_option

# Ensure dhcp-script hook for new device notifications
DNSMASQ_DHCP_SCRIPT="/etc/dnsmasq.d/10-pihole-ha-dhcp-script.conf"
DHCP_SCRIPT_BIN="/usr/local/bin/new_dhcp_device"
if [[ "$DHCP_HA" == "true" ]] && [[ -x "$DHCP_SCRIPT_BIN" ]] && [[ ! -f "$DNSMASQ_DHCP_SCRIPT" ]]; then
    printf 'dhcp-script=%s\n' "$DHCP_SCRIPT_BIN" > "$DNSMASQ_DHCP_SCRIPT"
    platform_ftl_restart 2>/dev/null || true
    log_info "event=dhcp_script_hook_created file=$DNSMASQ_DHCP_SCRIPT"
fi

# Pushover notifications (optional — configure /etc/pihole-ha/notify.conf).
# load_notify_conf and notify() live in pihole-ha-platform. Daemon callers
# below background with `&` so curl never blocks the failover loop.
load_notify_conf
get_dhcp() { platform_get_dhcp; }

# A peer reply we did not recognise, trimmed to something safe to put in a log
# line and in the status JSON: printable ASCII only, no control characters, and
# short. The caller escapes quotes for JSON; stripping them here too keeps the
# journal line readable.
_api_snippet() {
    local s="${1//[$'\t\r\n']/ }"
    s="${s//[^ -~]/}"
    s="${s//\"/\'}"
    s="${s//\\//}"
    printf '%.160s' "$s"
}

# Ensure we hold a valid cached SID for $ip, authenticating only if we don't
# already have one. MUST be called directly, never inside $(...): the whole point
# is that the peer_sid write below persists in the daemon process so we reuse one
# session per peer. (Pi-hole renews a session's validity on each use, so a session
# we keep using never expires.) Calling it in a command substitution would run it
# in a subshell, discard the cache write, and re-authenticate on every single API
# call — creating a brand-new Pi-hole session each time until the peer runs out of
# API session seats ("API seats exceeded").
ensure_sid() {
    local ip="$1"
    if [[ -z "${peer_password[$ip]:-}" ]]; then
        # auth.conf is per-node: each node holds the passwords for the peers IT
        # talks to, and saving one in the panel writes it only on the node serving
        # that panel. Setting it on one node and expecting the other to have it is
        # the single most common way to end up here, so say so by name.
        peer_auth_why[$ip]="no password for this peer is stored on THIS node (auth.conf is per-node — save it in this node's own HA panel, not a peer's)"
        return
    fi
    [[ -n "${peer_sid[$ip]:-}" ]] && return        # already have one — reuse it
    # Back off after a failure. Without this a peer that cannot authenticate is
    # re-hashed every CHECK_INTERVAL forever, which is itself enough to hold a
    # small Pi down. Retrying a wrong password faster does not make it righter.
    local now_s="$EPOCHSECONDS"
    [[ -n "${peer_auth_next[$ip]:-}" ]] && (( now_s < peer_auth_next[$ip] )) && return
    local resp rc=0
    local port="${NODE_PORTS[$ip]:-80}"
    # JSON-escape password: backslashes before quotes, then literal quotes.
    local _pw="${peer_password[$ip]}"
    _pw="${_pw//\\/\\\\}"
    _pw="${_pw//\"/\\\"}"
    local _raw=""
    # Keep the HTTP status: a reply that is not JSON at all (a redirect to https,
    # a different service on that port, a rate-limit page) is not a rejected
    # password, and calling it one sent an operator hunting a password that was
    # never wrong.
    _raw="$(curl -s --max-time "$AUTH_TIMEOUT" -w $'\n%{http_code}' -X POST "http://$ip:${port}/api/auth" \
        -H "Content-Type: application/json" \
        -d "{\"password\":\"${_pw}\"}" 2>/dev/null)" || rc=$?
    local http="${_raw##*$'\n'}"
    resp="${_raw%$'\n'*}"
    local sid=""
    [[ "$resp" =~ \"sid\":\"([^\"]*)\" ]] && sid="${BASH_REMATCH[1]}"
    if [[ -n "$sid" && "$sid" != "null" ]]; then
        peer_sid[$ip]="$sid"
        unset "peer_auth_next[$ip]" "peer_auth_why[$ip]"
        return
    fi
    # Failed. Record WHY, in the peer's own words where it gave us any, so the
    # operator is not left guessing between "slow", "wrong password" and "full".
    peer_auth_next[$ip]=$(( now_s + AUTH_RETRY_SEC ))
    if (( rc == 28 )); then
        # Name the knob that exists on THIS deployment. Telling a Docker operator
        # to edit nodes.conf sends them to a file the entrypoint regenerates.
        local _hint="raise AUTH_TIMEOUT in nodes.conf"
        [[ "${PIHOLE_HA_PLATFORM:-}" == "docker" ]] && _hint="raise PIHOLE_HA_AUTH_TIMEOUT in the container environment"
        peer_auth_why[$ip]="timed out after ${AUTH_TIMEOUT}s (the peer is still hashing the password — ${_hint})"
    elif [[ "$resp" == *"seats exceeded"* || "$resp" == *"api_seats_exceeded"* ]]; then
        peer_auth_why[$ip]="the peer reports API seats exceeded (raise webserver.api.max_sessions there, and check nothing is opening sessions it never closes)"
    elif (( rc != 0 )); then
        peer_auth_why[$ip]="could not reach the peer's API (curl rc=${rc})"
    elif [[ "$resp" == *'"valid":true'* ]]; then
        # Not a rejection: this peer needs no session at all.
        #
        # Keyed on "valid":true, NOT on the message, because the message lies.
        # Measured against a real passwordless Pi-hole:
        #   password ""      -> {"valid":true,"sid":null,"message":"no password set"}
        #   password "abc"   -> {"valid":true,"sid":null,"message":"password incorrect"}
        # So a passwordless peer literally answers "password incorrect" to any
        # password, and matching that prose would report the exact opposite of the
        # truth. "valid":true means the session state is already fine; the sid is a
        # literal null, which is why the quoted-sid match above misses.
        #
        # This used to land in the final else and be reported as "the peer rejected
        # the password", sending the operator to hunt a mismatch that never existed.
        # Calls to such a peer need no session, so there is nothing to retry: clear
        # the backoff and let the unauthenticated call through, which reports
        # auth="none".
        unset "peer_auth_next[$ip]"
        peer_auth_why[$ip]="that peer has NO Pi-hole password set, so it needs none from us — remove the password saved for it here (the stored one is unused)"
    elif [[ "$resp" =~ \"valid\"[[:space:]]*:[[:space:]]*false ]]; then
        # The ONLY reply that means the password is wrong. Pi-hole says so in
        # "valid"; its "message" is unreliable (a passwordless peer answers
        # "password incorrect" to everything), and everything else that can come
        # back here is not an answer about the password at all.
        peer_auth_why[$ip]="the peer rejected the password we have stored for it here"
    else
        peer_auth_why[$ip]="unexpected reply from the peer API on port ${port} (HTTP ${http:-none}): $(_api_snippet "$resp")"
    fi
    return
}

# Override local node's port from env var or FTL query (Docker may differ from nodes.conf)
if [[ -n "${PIHOLE_WEB_PORT:-}" ]]; then
    NODE_PORTS["$LOCAL_IP"]="$PIHOLE_WEB_PORT"
elif _ftl_port="$(pihole-FTL --config webserver.port 2>/dev/null | grep -o '^[0-9]*')" && [[ -n "$_ftl_port" ]]; then
    NODE_PORTS["$LOCAL_IP"]="$_ftl_port"
fi

# Build URL with SID query param if peer needs auth. Pure formatter — safe to
# call inside $(). It only reads the cached SID; ensure_sid (called directly by
# check_peer) is responsible for populating/refreshing it.
# Sets API_URL instead of echoing it. Every "$(api_url ...)" was a forked
# subshell just to concatenate a string, four times per peer per tick; with
# three peers on a 3s interval that alone was ~4 forks/sec on a Pi 3.
api_url() {
    local ip="$1" path="$2"
    local port="${NODE_PORTS[$ip]:-80}"
    local sid="${peer_sid[$ip]:-}"
    if [[ -n "$sid" ]]; then
        API_URL="http://$ip:${port}$path?sid=$sid"
    else
        API_URL="http://$ip:${port}$path"
    fi
}

has_vip() {
    [[ -n "$VIP" && -n "$IFACE" ]] || return 1
    ip -4 addr show dev "$IFACE" 2>/dev/null | grep -qE "inet $VIP/"
}

# Re-detect IFACE if missing (interface may rename after reboot or USB ethernet reattach)
ensure_iface() {
    [[ -n "$IFACE" ]] && ip link show "$IFACE" &>/dev/null && return 0
    IFACE="$(ip -o route get "$GATEWAY" 2>/dev/null | sed -n 's/.*dev \([^ ]*\).*/\1/p')"
    [[ -z "$IFACE" ]] && IFACE="$(ip -o link show up | grep -v lo | head -1 | awk -F': ' '{print $2}')"
    if [[ -n "$IFACE" ]]; then
        log_warn "event=iface_redetected iface=$IFACE"
        return 0
    fi
    log_error "event=iface_detect_failed gateway=$GATEWAY"
    return 1
}

add_vip() {
    [[ "$VIP_ENABLED" != "true" ]] && return 0
    if ! ensure_iface; then
        NOTIFY_TAG=vip_claim_failed notify "<b><font color='#e74c3c'>VIP CLAIM FAILED</font></b> <br> $LOCAL_IP: no network interface" &
        return 1
    fi
    has_vip && return 0
    local err
    err="$(ip addr add "$VIP/32" dev "$IFACE" 2>&1)" || {
        log_error "event=vip_add status=failed iface=$IFACE error=\"$err\""
        NOTIFY_TAG=vip_claim_failed notify "<b><font color='#e74c3c'>VIP CLAIM FAILED</font></b> <br> $LOCAL_IP iface=$IFACE <br> $err" &
        return 1
    }
    if ! has_vip; then
        log_error "event=vip_add status=verify_failed iface=$IFACE"
        NOTIFY_TAG=vip_claim_failed notify "<b><font color='#e74c3c'>VIP CLAIM VERIFY FAILED</font></b> <br> $LOCAL_IP: kernel did not bind $VIP on $IFACE" &
        return 1
    fi
    if command -v arping &>/dev/null; then
        arping -U -c3 -I "$IFACE" "$VIP" &>/dev/null &
    fi
    log_info "event=vip_add ip=$VIP iface=$IFACE status=ok"
    return 0
}

remove_vip() {
    has_vip || return 0
    local err
    err="$(ip addr del "$VIP/32" dev "$IFACE" 2>&1)" || {
        log_error "event=vip_remove status=failed iface=$IFACE error=\"$err\""
        return 1
    }
    log_info "event=vip_remove ip=$VIP iface=$IFACE status=ok"
}

set_dhcp() {
    local want="$1" have
    have="$(get_dhcp)"
    [[ "$have" == "$want" ]] && return 0
    platform_set_dhcp "$want"
    sleep 1
    have="$(get_dhcp)"
    [[ "$have" == "$want" ]]
}

# Hand a Pi-hole session back instead of abandoning it.
#
# Pi-hole allows a fixed number of concurrent API sessions (webserver.api.
# max_sessions, default 16) and each one we open lives for its full validity
# (30 min by default) whether or not we still hold it. The daemon cached one
# session per peer and never released it, so every restart — every update, every
# reboot, every config reload — orphaned one per peer for half an hour. Restart
# often enough while debugging and the peer answers "API seats exceeded" to
# everyone, including the operator's own browser. That is exactly what a reporter
# hit, and it read as an authentication fault rather than as exhaustion.
#
# Best-effort by design: a peer that has gone away cannot be logged out of, and
# failing to release must never delay or block shutdown.
release_sid() {
    local ip="$1"
    local sid="${peer_sid[$ip]:-}"
    [[ -z "$sid" ]] && return 0
    local port="${NODE_PORTS[$ip]:-80}"
    curl -s --max-time 3 -X DELETE "http://${ip}:${port}/api/auth?sid=${sid}" >/dev/null 2>&1 || true
    unset "peer_sid[$ip]"
}

release_all_sids() {
    local ip
    for ip in "${!peer_sid[@]}"; do release_sid "$ip"; done
}

# systemd sends SIGTERM on stop and on restart, so this covers updates and reboots
# as well as a plain stop. EXIT also catches an unexpected abort under `set -e`.
trap 'release_all_sids' EXIT INT TERM

# Does this peer's Pi-hole require a password RIGHT NOW?
#
# GET /api/auth with no credentials answers it for any node, and needs none to
# ask. Measured on both states:
#   passwordless -> {"valid":true,  "sid":null, "message":"no password set"}
#   protected    -> {"valid":false, "sid":null, "message":"no SID provided"}
# "valid" is the discriminator. The message is NOT usable: a passwordless Pi-hole
# answers "password incorrect" to an actual login attempt, which is the opposite
# of the truth.
#
# Asking is cheaper than finding out the hard way. It costs ~10us server-side
# (no password hash) against 0.7s on a fast Pi and 6-9s on a slow one, so on a
# passwordless peer — the default — this REPLACES the login attempt rather than
# adding to it. Before this existed the only way to learn the state was to try to
# log in and misinterpret the failure, which is how removing a password from a
# live cluster used to look like a rejected password.
#
# Echoes "true", "false", or nothing when it cannot be determined.
# Sets PEER_NEEDS_PASS ("true"/"false") and PEER_PROBE_REPLY (what came back),
# and returns non-zero when the answer was not a session state at all. MUST be
# called directly, never inside $(...): a subshell discards both globals, and
# the reply is the only thing that can explain a failure -- a Pi-hole with no
# API seats left refuses even this credential-free check, which used to surface
# as a bare "API FAIL" next to "No password (open)".
peer_requires_password() {
    # Split deliberately: `local ip="$1" port="${NODE_PORTS[$ip]...}"` reads $ip
    # before the same statement has finished assigning it, so the subscript comes
    # out empty and bash errors with "bad array subscript".
    local ip="$1"
    local port="${NODE_PORTS[$ip]:-80}"
    PEER_NEEDS_PASS=""; PEER_PROBE_REPLY=""
    PEER_PROBE_REPLY="$(curl -s --max-time "${HEALTH_TIMEOUT:-2}" "http://${ip}:${port}/api/auth" 2>/dev/null)" || return 1
    case "$PEER_PROBE_REPLY" in
        *'"valid":false'*) PEER_NEEDS_PASS="true"  ;;
        *'"valid":true'*)  PEER_NEEDS_PASS="false" ;;
        *) return 1 ;;
    esac
}

# Track the peer's password state and react to a CHANGE. A cached session keeps
# working against a peer whose password was just removed (a passwordless Pi-hole
# accepts any call), so without this the daemon can sit on a stale session
# indefinitely and only notice at the next restart.
update_needs_pass() {
    local ip="$1" now_v prev_v
    peer_requires_password "$ip" || return 0   # unknown: leave everything alone
    now_v="$PEER_NEEDS_PASS"
    prev_v="${peer_needs_pass[$ip]:-}"
    if [[ -n "$prev_v" && "$prev_v" != "$now_v" ]]; then
        log_info "event=peer_auth_mode_changed peer=$ip requires_password=$now_v reason=\"password state changed on that peer; dropping any cached session and re-evaluating\""
        unset "peer_sid[$ip]" "peer_auth_next[$ip]" "peer_auth_why[$ip]" "peer_auth_warned[$ip]"
    fi
    peer_needs_pass[$ip]="$now_v"
    # A peer that needs no password never needs a login. Say so if one is stored,
    # so a credential left over from before it was removed does not sit there
    # looking configured and meaningful.
    if [[ "$now_v" == "false" ]]; then
        release_sid "$ip"
        if [[ -n "${peer_password[$ip]:-}" ]]; then
            peer_auth_why[$ip]="that peer no longer requires a password — the one stored for it here is unused and can be cleared"
        fi
    fi
}

check_peer() {
    local ip="$1"
    if ping -c1 -W"$HEALTH_TIMEOUT" "$ip" >/dev/null 2>&1; then
        peer_ping[$ip]="true"
    else
        peer_ping[$ip]="false"; peer_dns[$ip]="false"
        peer_api[$ip]="false"; peer_dhcp[$ip]="null"; peer_leases[$ip]="null"; peer_clients[$ip]="null"; peer_auth[$ip]="null"
        return
    fi
    if nc -z -w"$HEALTH_TIMEOUT" "$ip" 53 >/dev/null 2>&1; then
        peer_dns[$ip]="true"
    else
        peer_dns[$ip]="false"; peer_api[$ip]="false"; peer_dhcp[$ip]="null"; peer_leases[$ip]="null"; peer_clients[$ip]="null"; peer_auth[$ip]="null"
        return
    fi
    # This node checking ITSELF never needs a session. Everything the API call
    # below would tell us about ourselves is already available locally: get_dhcp()
    # reads the DHCP state directly, and an unauthenticated GET /api/auth proves
    # our own web tier is alive. Authenticating to yourself only ever produced a
    # red "Password required" row against the node the operator is looking at —
    # for a node whose Pi-hole is password-protected but which has no password
    # stored for itself, which is the default after any install.
    if [[ "$ip" == "$LOCAL_IP" ]]; then
        # update_needs_pass runs the probe and leaves its result in the globals
        # below, so this costs no extra request.
        update_needs_pass "$ip"
        peer_dhcp[$ip]="$(get_dhcp)"
        [[ "${peer_dhcp[$ip]}" == "true" || "${peer_dhcp[$ip]}" == "false" ]] || peer_dhcp[$ip]="null"
        peer_leases[$ip]="null"; peer_clients[$ip]="null"
        if [[ -n "$PEER_NEEDS_PASS" ]]; then
            peer_api[$ip]="true"
            # "none" means open. A protected node needs no session from itself
            # either, but saying "no password" about a node that plainly has one
            # is how this row got read as a fault.
            if [[ "$PEER_NEEDS_PASS" == "true" ]]; then
                peer_auth[$ip]="\"self\""
            else
                peer_auth[$ip]="\"none\""
            fi
            unset "peer_auth_why[$ip]"
        else
            peer_api[$ip]="false"
            peer_auth[$ip]="null"
            local _selfport="${NODE_PORTS[$ip]:-80}"
            if [[ "$PEER_PROBE_REPLY" == *"seats exceeded"* || "$PEER_PROBE_REPLY" == *"api_seats_exceeded"* ]]; then
                peer_auth_why[$ip]="this node's own Pi-hole is out of API seats, so it refuses every login including ours (raise webserver.api.max_sessions here, and restart pihole-FTL to release the ones held now)"
            elif [[ -n "$PEER_PROBE_REPLY" ]]; then
                peer_auth_why[$ip]="unexpected reply from this node's own Pi-hole API on port ${_selfport}: $(_api_snippet "$PEER_PROBE_REPLY")"
            else
                peer_auth_why[$ip]="this node's own Pi-hole API on port ${_selfport} did not answer"
            fi
        fi
        return
    fi
    local resp url
    update_needs_pass "$ip"
    # Only attempt a login when the peer actually wants one. On a passwordless
    # peer this skips a multi-second password hash entirely.
    [[ "${peer_needs_pass[$ip]:-true}" == "false" ]] || ensure_sid "$ip"
    api_url "$ip" /api/config/dhcp/active; url="$API_URL"
    resp="$(curl -s --max-time "$HEALTH_TIMEOUT" "$url" 2>/dev/null)" || {
        peer_api[$ip]="false"; peer_dhcp[$ip]="null"; peer_leases[$ip]="null"; peer_clients[$ip]="null"; peer_auth[$ip]="null"; return
    }
    # If 401, our SID expired/was evicted — drop it, re-auth once, and retry.
    if [[ "$resp" == *'"unauthorized"'* ]]; then
        # Give the dead session back before minting another. This path runs
        # whenever a session is evicted or expires, so abandoning here leaks a
        # seat far more often than a restart does.
        release_sid "$ip"
        ensure_sid "$ip"
        api_url "$ip" /api/config/dhcp/active; url="$API_URL"
        resp="$(curl -s --max-time "$HEALTH_TIMEOUT" "$url" 2>/dev/null)" || {
            peer_api[$ip]="false"; peer_dhcp[$ip]="null"; peer_leases[$ip]="null"; peer_clients[$ip]="null"; peer_auth[$ip]="\"denied\""; return
        }
        if [[ "$resp" == *'"unauthorized"'* ]]; then
            # api=TRUE on purpose. The peer answered us — with a refusal, but it
            # answered, which proves its API is alive. Recording false here meant
            # is_serving() saw a dead peer and this node seized DHCP and the VIP
            # from a primary that was healthily serving the network, logging the
            # plainly untrue "API unreachable". An authentication problem must not
            # be able to cause an outage; it stops SYNC (which needs authorised
            # writes — see is_alive_for_publish) and nothing else.
            peer_api[$ip]="true"; peer_dhcp[$ip]="null"; peer_leases[$ip]="null"; peer_clients[$ip]="null"; peer_auth[$ip]="\"denied\""
            # Say this out loud, once per peer. A peer we cannot authenticate to
            # is treated as DOWN, so every node elects itself publisher and
            # nothing is ever pulled -- config sync silently stops dead. Without
            # a line naming the cause, the only visible symptom is a repeated
            # sync_promote and records that never arrive.
            # Only for real peers: a failed check against our OWN API never
            # gates publishing (is_alive_for_publish short-circuits on self), so
            # warning that sync will stop would be false there.
            if [[ "$ip" != "$LOCAL_IP" && "${peer_auth_warned[$ip]:-}" != "true" ]]; then
                peer_auth_warned[$ip]="true"
                if [[ -z "${peer_password[$ip]:-}" ]]; then
                    log_warn "event=peer_auth_missing peer=$ip reason=\"peer's Pi-hole needs a password and none is set for it here — add it in the HA panel (Cluster Nodes) or in $AUTH_CONF as PASS_${ip//./_}=... ; until then this peer counts as down and config sync will not run\""
                else
                    # NOTE: no apostrophes inside this ${...:-default}. Bash parses
                    # the default value with its own quoting rules, so a lone ' opens
                    # a quote even inside the surrounding double quotes and swallows
                    # the rest of the script (it failed to parse 146 lines later).
                    # Report the SPECIFIC failure ensure_sid recorded. "Denied"
                    # alone sent at least one operator chasing their hardware
                    # when the real answer was a timeout that could never be met.
                    log_warn "event=peer_auth_denied peer=$ip reason=\"${peer_auth_why[$ip]:-the password configured here was rejected by that peer} — until this is fixed the peer counts as down and config sync will not run; retrying in ${AUTH_RETRY_SEC}s\""
                fi
            fi
            return
        fi
    fi
    peer_api[$ip]="true"
    # Recovered: allow a future failure to warn again.
    peer_auth_warned[$ip]="false"
    # Distinguish "authenticated with a session" from "open, no password". We only
    # ever hold a SID for a peer we actually logged into (ensure_sid no-ops when no
    # password is configured), so a successful call with no SID means the peer has
    # no password set — reflect that honestly instead of claiming "authenticated".
    if [[ -n "${peer_sid[$ip]:-}" ]]; then
        peer_auth[$ip]="\"ok\""
    else
        peer_auth[$ip]="\"none\""
    fi
    # Client count from stats summary. The bash match reproduces
    # `grep -o '"active":[0-9]*' | head -1 | grep -o '[0-9]*'` exactly: =~ finds
    # the first '"active":' the same way head -1 did, and [0-9]* captures an
    # empty string there too, which the -z test below still maps to null.
    local stats
    api_url "$ip" /api/stats/summary
    stats="$(curl -s --max-time 2 "$API_URL" 2>/dev/null)"
    if [[ "$stats" =~ \"active\":([0-9]*) ]]; then
        peer_clients[$ip]="${BASH_REMATCH[1]}"
    else
        peer_clients[$ip]=""
    fi
    [[ -z "${peer_clients[$ip]}" ]] && peer_clients[$ip]="null"
    if [[ "$resp" == *'"active":true'* ]]; then
        peer_dhcp[$ip]="true"
        # Count '"expires"' occurrences without grep|wc: strip them out and
        # divide the length difference by the needle length.
        local _leases _stripped _needle='"expires"'
        api_url "$ip" /api/dhcp/leases
        _leases="$(curl -s --max-time 2 "$API_URL" 2>/dev/null)"
        _stripped="${_leases//$_needle/}"
        peer_leases[$ip]=$(( (${#_leases} - ${#_stripped}) / ${#_needle} ))
    elif [[ "$resp" == *'"active":false'* ]]; then
        peer_dhcp[$ip]="false"; peer_leases[$ip]="null"
    else
        peer_dhcp[$ip]="null"; peer_leases[$ip]="null"
    fi
}

is_serving() {
    local ip="$1"
    # Defaults matter: a pinned DHCP_MASTER that has left the cluster is never
    # health-checked, and a bare lookup would abort the daemon under `set -u`.
    [[ "${peer_ping[$ip]:-}" == "true" ]] || return 1
    [[ "${peer_dns[$ip]:-}" == "true" ]]  || return 1
    [[ "${peer_api[$ip]:-}" == "true" ]]  || return 1
    [[ "${peer_dhcp[$ip]:-}" == "true" ]] && return 0
    # DHCP state is UNKNOWN because we cannot authenticate to read it — but ping,
    # DNS and the API all answered, so the peer is alive and most likely serving.
    # Taking over on "unknown" is how you end up with two DHCP servers on one
    # LAN; refusing to take over merely leaves the existing one in charge. The
    # loud peer_auth_denied warning is what gets this fixed, not a failover.
    [[ "${peer_auth[$ip]:-}" == '"denied"' ]] && return 0
    return 1
}

get_fail_reason() {
    local ip="$1" r=""
    # A manually pinned DHCP_MASTER can name a node that is no longer in
    # HA_NODES, so it never gets health-checked and has no peer_* entries.
    # Under `set -u` a bare lookup aborts the daemon, so default every read.
    if [[ -z "${peer_ping[$ip]:-}" ]]; then
        echo "not a cluster member"
        return
    fi
    [[ "${peer_ping[$ip]:-}" != "true" ]] && r+="ping failed, "
    [[ "${peer_dns[$ip]:-}" != "true" ]] && r+="DNS:53 down, "
    [[ "${peer_api[$ip]:-}" != "true" ]] && r+="API unreachable, "
    [[ "${peer_auth[$ip]:-}" == '"denied"' ]] && r+="API answering but refusing our login, "
    [[ "${peer_dhcp[$ip]:-}" == "false" ]] && r+="DHCP disabled, "
    [[ "${peer_dhcp[$ip]:-}" == "null" && "${peer_api[$ip]:-}" == "true" ]] && r+="DHCP unknown, "
    echo "${r%, }"
}

is_cluster_member() {
    local ip="$1" n
    for n in "${NODES[@]}"; do
        [[ "$n" == "$ip" ]] && return 0
    done
    return 1
}

should_i_serve() {
    # A pin naming a node that is no longer in HA_NODES is never health-checked,
    # so it reads as "master is down" and every remaining node takes over at
    # once. An unverifiable pin is a stale pin — fall back to priority order.
    if [[ "$DHCP_MASTER" != "auto" ]] && ! is_cluster_member "$DHCP_MASTER"; then
        if [[ "${_warned_stale_master:-}" != "$DHCP_MASTER" ]]; then
            log_warn "event=stale_dhcp_master master=$DHCP_MASTER reason=not_a_member action=using_priority_order"
            _warned_stale_master="$DHCP_MASTER"
        fi
        DHCP_MASTER="auto"
    fi
    if [[ "$DHCP_MASTER" != "auto" ]]; then
        # Manual override mode
        if [[ "$DHCP_MASTER" == "$LOCAL_IP" ]]; then
            return 0  # I am the designated master
        fi
        # Designated master is healthy — yield to it
        is_serving "$DHCP_MASTER" && return 1
        # Designated master is down — fallback to priority among remaining
        for (( i=0; i<MY_IDX; i++ )); do
            [[ "${NODES[$i]}" == "$DHCP_MASTER" ]] && continue
            is_serving "${NODES[$i]}" && return 1
        done
        return 0
    fi
    # Auto mode: original priority logic
    (( MY_IDX == 0 )) && return 0
    for (( i=0; i<MY_IDX; i++ )); do
        is_serving "${NODES[$i]}" && return 1
    done
    return 0
}

build_reason() {
    if [[ "$DHCP_MASTER" != "auto" ]]; then
        if [[ "$DHCP_MASTER" == "$LOCAL_IP" ]]; then
            echo "Manual DHCP master"
            return
        fi
        # Designated master is down, we're taking over
        local parts="Manual master $DHCP_MASTER down: $(get_fail_reason "$DHCP_MASTER")"
        for (( i=0; i<MY_IDX; i++ )); do
            [[ "${NODES[$i]}" == "$DHCP_MASTER" ]] && continue
            [[ -n "$parts" ]] && parts+=" | "
            parts+="${ROLES[$i]} ${NODES[$i]}: $(get_fail_reason "${NODES[$i]}")"
        done
        echo "$parts"
        return
    fi
    if (( MY_IDX == 0 )); then
        echo "Primary enforcing DHCP"
    else
        local parts=""
        for (( i=0; i<MY_IDX; i++ )); do
            [[ -n "$parts" ]] && parts+=" | "
            parts+="${ROLES[$i]} ${NODES[$i]}: $(get_fail_reason "${NODES[$i]}")"
        done
        echo "$parts"
    fi
}

yielded_to() {
    if [[ "$DHCP_MASTER" != "auto" && "$DHCP_MASTER" != "$LOCAL_IP" ]]; then
        if is_serving "$DHCP_MASTER"; then
            echo "Manual master ($DHCP_MASTER)"
            return
        fi
    fi
    # Return which higher-priority node(s) are serving
    local parts=""
    for (( i=0; i<MY_IDX; i++ )); do
        is_serving "${NODES[$i]}" && parts+="${ROLES[$i]} (${NODES[$i]}), "
    done
    echo "${parts%, }"
}

# --- DNS-only VIP failover helpers ---
# Health for DNS failover deliberately excludes the Pi-hole API and DHCP: all we
# need to know is whether the node can answer DNS (port 53). Requiring the API
# would let a password-locked peer look "down" and trigger a false takeover.
is_dns_healthy() {
    local ip="$1"
    [[ "${peer_ping[$ip]}" == "true" ]] && [[ "${peer_dns[$ip]}" == "true" ]]
}

# Priority election for the DNS VIP. Hold it only if this node can itself answer
# DNS *and* no higher-priority node is answering DNS. The local-health check is
# essential: without it a primary whose own DNS is down (but whose daemon is
# still up) would keep the VIP while a secondary also claims it — split-brain.
# (No manual-master concept here — that's DHCP-specific.)
should_i_hold_vip() {
    is_dns_healthy "$LOCAL_IP" || return 1
    local i
    for (( i=0; i<MY_IDX; i++ )); do
        is_dns_healthy "${NODES[$i]}" && return 1
    done
    return 0
}

build_dns_reason() {
    if (( MY_IDX == 0 )); then
        echo "Primary holding DNS VIP"
        return
    fi
    local parts="" i
    for (( i=0; i<MY_IDX; i++ )); do
        [[ -n "$parts" ]] && parts+=" | "
        parts+="${ROLES[$i]} ${NODES[$i]}: $(get_fail_reason "${NODES[$i]}")"
    done
    echo "$parts"
}

write_status() {
    local reason="${1:-}" gw="${2:-true}" dhcp
    dhcp="$(get_dhcp)"
    local vip_held="false"
    has_vip && vip_held="true"
    local tmp="$STATUS_FILE.tmp"
    {
        printf '{"ha_enabled":%s,"dhcp_master":"%s","node":{"ip":"%s","role":"%s","priority":%d,"dhcp_active":%s,"vip":"%s","vip_enabled":%s,"vip_held":%s},' \
            "$HA_ENABLED" "$DHCP_MASTER" "$LOCAL_IP" "$ROLE" "$PRIORITY" "$dhcp" "$VIP" "$VIP_ENABLED" "$vip_held"
        printf '"gateway":%s,"timestamp":"%s",' "$gw" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        printf '"reason":"%s","peers":{' "$(echo "$reason" | sed 's/"/\\"/g')"
        local sep=""
        for (( i=0; i<NODE_COUNT; i++ )); do
            local ip="${NODES[$i]}"
            # auth_why carries the SPECIFIC login failure to the panel. Without it
            # the panel can only say "denied", so a misconfiguration and a timeout
            # look identical and the Auth row just spins. JSON-escape it: the text
            # is operator-facing prose and contains quotes and backslashes.
            local _why="${peer_auth_why[$ip]:-}"
            _why="${_why//\\/\\\\}"; _why="${_why//\"/\\\"}"
            local _why_json="null"; [[ -n "$_why" ]] && _why_json="\"${_why}\""
            printf '%s"%s":{"role":"%s","priority":%d,"ping":%s,"dns":%s,"api":%s,"dhcp":%s,"leases":%s,"clients":%s,"auth":%s,"auth_why":%s,"needs_password":%s}' \
                "$sep" "$ip" "${ROLES[$i]}" "$((i+1))" \
                "${peer_ping[$ip]:-null}" "${peer_dns[$ip]:-null}" \
                "${peer_api[$ip]:-null}" "${peer_dhcp[$ip]:-null}" \
                "${peer_leases[$ip]:-null}" "${peer_clients[$ip]:-null}" \
                "${peer_auth[$ip]:-null}" "$_why_json" \
                "$([[ -n "${peer_needs_pass[$ip]:-}" ]] && printf '%s' "${peer_needs_pass[$ip]}" || printf 'null')"
            sep=","
        done
        printf '}}\n'
    } > "$tmp"
    # A partial write must never replace a good status file. When /run filled up
    # the printfs above failed one by one, the truncated leftover was promoted
    # anyway, and the admin panel then read invalid JSON -- reporting a problem
    # with nothing to do with the real one. Only promote a document that is
    # actually complete; otherwise keep the last good one and say why.
    if [[ ! -s "$tmp" ]] || [[ "$(tail -c 3 "$tmp" 2>/dev/null | tr -d '\n')" != "}}" ]]; then
        rm -f "$tmp"
        if [[ "${_status_write_warned:-}" != "true" ]]; then
            _status_write_warned=true
            local _free
            _free="$(df -Pk "$STATUS_DIR" 2>/dev/null | awk 'NR==2{print int($4/1024)}')"
            log_error "event=status_write_failed file=$STATUS_FILE free_mb=${_free:-unknown} reason=\"could not write a complete status file (is the filesystem full?) — keeping the previous one so the panel is not fed a truncated document\""
        fi
        return 1
    fi
    _status_write_warned=false
    mv "$tmp" "$STATUS_FILE"
}

# DNS-only deployment cycle. DHCP is never touched. If a VIP is configured, the
# highest-priority DNS-healthy node holds it, giving clients pointed at the VIP
# real health-based DNS failover — the piece a plain two-server resolv.conf
# can't do. With no VIP configured this is a no-op beyond monitoring + sync, so
# existing DNS-only installs behave exactly as before.
dns_only_vip_cycle() {
    # No VIP, or HA kill-switch off → monitor only (original behavior).
    if [[ "$VIP_ENABLED" != "true" || -z "$VIP" ]]; then
        write_status "DNS-only (DHCP not managed)"
        return
    fi
    if [[ "$HA_ENABLED" != "true" ]]; then
        has_vip && remove_vip
        write_status "DNS-only - HA disabled"
        return
    fi
    # LAN outage: don't hold a VIP we can't serve on.
    if ! ping -c1 -W"$HEALTH_TIMEOUT" "$GATEWAY" >/dev/null 2>&1; then
        activate_count=0; deactivate_count=0
        has_vip && remove_vip
        write_status "DNS-only - LAN outage - gateway unreachable" "false"
        return
    fi

    if should_i_hold_vip; then
        deactivate_count=0
        if has_vip; then
            activate_count=0
            write_status "DNS-only - holding VIP $VIP"
            return
        fi
        (( activate_count++ )) || true
        if (( activate_count >= ACTIVATE_AFTER )); then
            local reason; reason="$(build_dns_reason)"
            log_info "event=vip_claim mode=dns-only reason=\"$reason\""
            if add_vip; then
                notify "<b><font color='#2ecc71'>$ROLE DNS VIP ACQUIRED</font></b> <br> <font color='#95a5a6'>$LOCAL_IP</font> now holds VIP <b>$VIP</b> <br> <font color='#e74c3c'>$reason</font>" &
            fi
            activate_count=0
            write_status "DNS-only - holding VIP $VIP"
        else
            write_status "DNS-only - claiming VIP ($activate_count/$ACTIVATE_AFTER)"
        fi
    else
        activate_count=0
        if ! has_vip; then
            deactivate_count=0
            write_status "DNS-only - standby"
            return
        fi
        (( deactivate_count++ )) || true
        if (( deactivate_count >= DEACTIVATE_AFTER )); then
            log_info "event=vip_release mode=dns-only"
            remove_vip
            notify "<b><font color='#f39c12'>$ROLE DNS VIP RELEASED</font></b> <br> <font color='#95a5a6'>$LOCAL_IP</font> released VIP <b>$VIP</b>, yielding to higher-priority node" &
            deactivate_count=0
            write_status "DNS-only - standby"
        else
            write_status "DNS-only - releasing VIP ($deactivate_count/$DEACTIVATE_AFTER)"
        fi
    fi
}

# --- Config-sync publisher role (active-active with the DHCP/VIP failover) ---
# The sync publisher (source of config truth) follows the same highest-priority-
# alive rule as the DHCP master. When the configured primary is down a survivor
# auto-promotes and publishes; when the primary returns it FIRST pulls the newer
# config from whoever was acting, THEN reclaims the publisher role — so a stale
# returning primary can never overwrite changes made during the outage.

is_alive_for_publish() {
    local ip="$1"
    [[ "$ip" == "$LOCAL_IP" ]] && return 0
    [[ "${peer_ping[$ip]:-}" == "true" ]] || return 1
    [[ "${peer_dns[$ip]:-}" == "true" ]] || return 1
    [[ "${peer_api[$ip]:-}" == "true" ]] || return 1
    # Sync writes need an authorised session, so a denied peer really cannot be
    # published to. This is the ONE place an auth failure should stop something —
    # api=true above now means "answered", not "authorised".
    [[ "${peer_auth[$ip]:-}" == '"denied"' ]] && return 1
    return 0
}

# The acting sync primary is the highest-priority node that's alive to publish.
acting_primary_ip() {
    local i
    for (( i=0; i<NODE_COUNT; i++ )); do
        is_alive_for_publish "${NODES[$i]}" && { echo "${NODES[$i]}"; return; }
    done
    echo ""
}

read_sync_primary() {
    local _sp=""
    [[ -f "$SYNC_CONF" ]] && _sp="$(grep -E '^SYNC_PRIMARY=' "$SYNC_CONF" | head -1 | cut -d= -f2)"
    [[ -z "$_sp" ]] && _sp="${NODES[0]}"
    echo "$_sp"
}

write_sync_primary() {
    local new="$1"
    mkdir -p /etc/pihole-ha
    if [[ -f "$SYNC_CONF" ]] && grep -q '^SYNC_PRIMARY=' "$SYNC_CONF"; then
        sed -i "s/^SYNC_PRIMARY=.*/SYNC_PRIMARY=$new/" "$SYNC_CONF"
    else
        echo "SYNC_PRIMARY=$new" >> "$SYNC_CONF"
    fi
}

# Pull-once from the peer with the highest generation. Used when the configured
# primary returns and a peer (the acting primary during the outage) holds newer
# config. Synchronous — blocks this tick for the catch-up, which is rare.
catch_up_from_peers() {
    local _local_ver _best_ver _best_ip _peer_ver _ip _pull_script _ok
    _local_ver="$(cat "$VER_FILE" 2>/dev/null || echo 0)"
    _best_ver=$_local_ver
    _best_ip=""
    for _ip in "${NODES[@]}"; do
        [[ "$_ip" == "$LOCAL_IP" ]] && continue
        is_alive_for_publish "$_ip" || continue
        _peer_ver="$(curl -sf --max-time 3 "http://$_ip:8887/api/sync/version" 2>/dev/null | grep -o '"version":[0-9]*' | cut -d: -f2)"
        [[ -z "$_peer_ver" ]] && continue
        if (( _peer_ver > _best_ver )); then _best_ver=$_peer_ver; _best_ip=$_ip; fi
    done
    [[ -z "$_best_ip" ]] && return 0
    log_info "event=sync_catchup_pull source=$_best_ip peer_ver=$_best_ver local_ver=$_local_ver"
    _ok=false
    for _pull_script in /usr/local/bin/pihole-ha-sync-pull ./pihole-ha-sync-pull; do
        [[ -x "$_pull_script" ]] || continue
        PULL_SOURCE="$_best_ip" "$_pull_script" --force >/dev/null 2>&1 && _ok=true
        break
    done
    if [[ "$_ok" != "true" ]]; then
        log_warn "event=sync_catchup_fail source=$_best_ip — publishing with what we have"
        return 1
    fi
    log_info "event=sync_catchup_done source=$_best_ip version=$_best_ver"
    return 0
}

# Reconcile the sync publisher role each tick. Every node independently computes
# the same acting primary (highest-priority alive) and converges its sync.conf +
# timers to match — no RPC needed.
manage_sync_role() {
    # A lone node has nobody to publish to and nobody to pull from. Running the
    # election anyway makes it claim the publisher role and announce that it
    # took over from a node it is no longer clustered with.
    (( NODE_COUNT > 1 )) || return 0
    local _se="true"
    if [[ -f "$SYNC_CONF" ]]; then
        _se="$(grep -E '^SYNC_ENABLED=' "$SYNC_CONF" | head -1 | cut -d= -f2)"
        [[ -z "$_se" ]] && _se="true"
    fi
    [[ "$_se" != "true" ]] && return 0

    local _ap _current
    _ap="$(acting_primary_ip)"
    [[ -z "$_ap" ]] && return 0
    _current="$(read_sync_primary)"

    if [[ "$_ap" == "$LOCAL_IP" ]]; then
        if [[ "$_current" != "$LOCAL_IP" ]]; then
            # Becoming publisher: catch up to the highest config-version FIRST, so
            # this node can't overwrite newer config held by another node (e.g. a
            # lease added on a lower-priority survivor during a multi-node outage).
            # Version-gated, so it's a no-op unless a peer is genuinely newer —
            # safe for ANY promoting node, not just the configured primary.
            catch_up_from_peers || true
            log_info "event=sync_promote acting_primary=$LOCAL_IP previous=$_current"
            write_sync_primary "$LOCAL_IP"
            platform_sync_pull_disable
            platform_sync_enable
            echo "PUBLISHER" > "$SYNC_ROLE_FILE"
            NOTIFY_TAG=sync_role_change notify "<b><font color='#2ecc71'>Sync Publisher</font></b> <br> $ROLE ($LOCAL_IP) is now publishing config <br> Previous: $_current" &
        fi
        # Level-triggered, not edge-triggered. The block above only fires when the
        # role CHANGES, so a node that already believes it is the publisher never
        # re-checks that its build timer is actually running -- and if something
        # stopped it (a demotion during a failover, a manual stop), it stays
        # stopped forever. "Running" also means due to fire: a timer can be
        # active with no trigger left to wait on (issue #7), which is just as
        # dead. The primary then serves no manifest, every standby
        # logs "no peer has a manifest" on every tick, and nothing above INFO
        # says so. Converge the real state to the believed role each cycle.
        if ! platform_sync_is_running; then
            log_warn "event=sync_timer_recovered role=publisher reason=\"build timer was stopped or not due to fire\""
            platform_sync_enable
        fi
    else
        if [[ "$_current" == "$LOCAL_IP" ]]; then
            log_info "event=sync_demote acting_primary=$_ap previous=$LOCAL_IP"
            write_sync_primary "$_ap"
            platform_sync_disable
            platform_sync_pull_enable
            echo "STANDBY" > "$SYNC_ROLE_FILE"
            NOTIFY_TAG=sync_role_change notify "<b><font color='#f39c12'>Sync Yielded</font></b> <br> $ROLE ($LOCAL_IP) yielded publisher to $_ap" &
        elif [[ "$_current" != "$_ap" ]]; then
            log_info "event=sync_primary_changed from=$_current to=$_ap"
            write_sync_primary "$_ap"
            echo "STANDBY" > "$SYNC_ROLE_FILE"
        fi
        # Same convergence for the other direction: a standby with a stopped pull
        # timer silently stops receiving config. Only ever START what this role
        # needs -- stopping the other timer is what creates the trap, and the
        # sync scripts already exit early when the role is not theirs.
        if ! platform_sync_pull_is_running; then
            log_warn "event=sync_timer_recovered role=standby reason=\"pull timer was stopped or not due to fire\""
            platform_sync_pull_enable
        fi
    fi
}

# --- Main Loop ---
log_info "event=startup ip=$LOCAL_IP priority=$PRIORITY interval=${CHECK_INTERVAL}s activate_after=$ACTIVATE_AFTER deactivate_after=$DEACTIVATE_AFTER"
log_info "event=startup checks=\"ping dns:53 api dhcp\""
if [[ "$HA_ENABLED" != "true" ]]; then
    # Announcing "PRIMARY DHCP Monitor Started" here reads as though this node
    # just took charge of DHCP, which is the opposite of what HA-off means.
    if (( NODE_COUNT == 1 )); then
        NOTIFY_TAG=daemon_lifecycle notify "<b><font color='#95a5a6'>Standalone</font></b> <br> <font color='#95a5a6'>$LOCAL_IP</font> started outside any cluster <br> Not managing DHCP or the VIP" &
    else
        NOTIFY_TAG=daemon_lifecycle notify "<b><font color='#95a5a6'>HA Disabled</font></b> <br> <font color='#95a5a6'>$LOCAL_IP</font> started with failover switched off <br> Order: ${NODES[*]} <br> Not managing DHCP or the VIP" &
    fi
else
    NOTIFY_TAG=daemon_lifecycle notify "<b><font color='#3498db'>$ROLE</font> DHCP Monitor Started</b> <br> <font color='#95a5a6'>$LOCAL_IP</font> (P<b>$PRIORITY</b>) <br> Order: ${NODES[*]} <br> VIP: $VIP ($([[ "$VIP_ENABLED" == "true" ]] && echo enabled || echo disabled)) <br> HA: enabled" &
fi

while true; do
    sleep "$CHECK_INTERVAL"
    load_auth         # reload passwords in case user saved new ones via web UI
    # Re-read STANDBY_ONLY each round so it can be set or lifted without a restart —
    # the point of it is to calm a cluster that is already misbehaving.
    STANDBY_ONLY="$(sed -n 's/^STANDBY_ONLY=//p' "$NODES_CONF" 2>/dev/null | tr -d '"'"'"'" ' | head -1)"
    STANDBY_ONLY="${STANDBY_ONLY:-false}"
    load_notify_conf  # reload notify settings so per-kind mute toggles take effect live
    load_master       # reload DHCP master override (live config changes)
    # Re-assert the DNS pin. Startup alone is not enough: the pin is deferred
    # while the local resolver is not answering (a fresh node is still building
    # gravity), and something else can rewrite resolv.conf later -- a DHCP lease
    # renewal, NetworkManager. Cheap: returns immediately once it is already
    # pinned, which is the steady state.
    enforce_dns_pin
    if reload_vip_conf; then  # only update DNS option when VIP config actually changes
        ensure_dns_option
    fi

    # Always run health checks so dashboard shows real peer state
    for ip in "${NODES[@]}"; do check_peer "$ip"; done

    # Reconcile the config-sync publisher role (auto-promote / catch-up / yield)
    manage_sync_role

    # DNS-only deployment: another server handles DHCP. Never manage dhcp.active;
    # run config sync and (if a VIP is configured) health-based VIP failover so
    # clients pointed at the VIP get real DNS redundancy.
    if [[ "$DHCP_HA" != "true" ]]; then
        dns_only_vip_cycle
        continue
    fi

    if [[ "$HA_ENABLED" != "true" ]]; then
        write_status "HA disabled"
        continue
    fi
    # No peers means no failover decision can be made safely. A node that was
    # evicted from a cluster looks identical, from here, to a node whose peers
    # all died — and guessing "sole survivor" makes it seize a VIP another node
    # is still holding and start a second DHCP server on the LAN. Leave DHCP and
    # the VIP exactly as they are until the node has a peer to compare against.
    if (( NODE_COUNT == 1 )); then
        activate_count=0; deactivate_count=0
        write_status "Standalone - no peers to fail over to"
        continue
    fi
    if ! ensure_ftl_running; then
        write_status "pihole-FTL down"
        continue
    fi

    if ! ping -c1 -W"$HEALTH_TIMEOUT" "$GATEWAY" >/dev/null 2>&1; then
        log_warn "event=gateway_unreachable gateway=$GATEWAY"
        activate_count=0; deactivate_count=0
        write_status "LAN outage - gateway unreachable" "false"
        continue
    fi

    current="$(get_dhcp)"

    # STANDBY_ONLY: never take over, whatever the peers look like. Asked for after
    # a cluster where a node that could not authenticate promoted itself, seized
    # DHCP and the VIP, and fought the healthy primary — leaving no safe way to
    # bring a node up and look at it. Re-read every loop from nodes.conf, so it can
    # be lifted without a restart.
    if [[ "${STANDBY_ONLY:-false}" == "true" ]]; then
        if [[ "$(get_dhcp)" == "true" ]]; then
            log_warn "event=standby_only_release reason=\"STANDBY_ONLY is set but this node holds DHCP — releasing it\""
            set_dhcp "false" || true
            has_vip && remove_vip || true
        fi
        write_status "STANDBY_ONLY set - this node will never take over"
        continue
    fi

    if should_i_serve; then
        deactivate_count=0; stable_count=0
        if [[ "$current" == "true" ]]; then
            has_vip || add_vip  # Ensure VIP is present when serving
            activate_count=0
            write_status "$(build_reason)"
            continue
        fi
        (( activate_count++ )) || true
        if (( activate_count >= ACTIVATE_AFTER )); then
            reason="$(build_reason)"
            log_info "event=dhcp_activate reason=\"$reason\""
            add_vip
            if set_dhcp "true"; then
                vip_msg=""
                [[ "$VIP_ENABLED" == "true" ]] && vip_msg=" <br> VIP <b>$VIP</b> acquired"
                # Build detailed per-node health breakdown for notification
                detail=""
                for (( _ni=0; _ni<NODE_COUNT; _ni++ )); do
                    _nip="${NODES[$_ni]}"
                    [[ "$_nip" == "$LOCAL_IP" ]] && continue
                    _st=""
                    if [[ "${peer_ping[$_nip]}" == "true" ]]; then _st+="<font color='#3fb950'>ping</font> "; else _st+="<font color='#f85149'>ping</font> "; fi
                    if [[ "${peer_dns[$_nip]}" == "true" ]]; then _st+="<font color='#3fb950'>dns</font> "; else _st+="<font color='#f85149'>dns</font> "; fi
                    if [[ "${peer_api[$_nip]}" == "true" ]]; then _st+="<font color='#3fb950'>api</font> "; else _st+="<font color='#f85149'>api</font> "; fi
                    if [[ "${peer_dhcp[$_nip]}" == "true" ]]; then _st+="<font color='#3fb950'>dhcp</font>"; elif [[ "${peer_dhcp[$_nip]}" == "false" ]]; then _st+="<font color='#d29922'>dhcp:off</font>"; else _st+="<font color='#f85149'>dhcp</font>"; fi
                    detail+=" <br> <font color='#8b949e'>${ROLES[$_ni]}</font> $_nip: $_st"
                done
                NOTIFY_TAG=dhcp_activated notify "<b><font color='#2ecc71'>$ROLE DHCP ACTIVATED</font></b> <br> <font color='#95a5a6'>$LOCAL_IP</font> now serving DHCP${vip_msg} <br> <font color='#e74c3c'>$reason</font>${detail}" &
                log_info "event=dhcp_activate status=ok"
            else
                NOTIFY_TAG=dhcp_failover_failed notify "<b><font color='#e74c3c'>$ROLE DHCP ACTIVATION FAILED</font></b> <br> <font color='#95a5a6'>$LOCAL_IP</font> could not enable DHCP" &
                log_error "event=dhcp_activate status=failed"
            fi
            activate_count=0
            write_status "$reason"
        else
            log_info "event=dhcp_activate_pending count=$activate_count/$ACTIVATE_AFTER"
            write_status "$(build_reason)"
        fi
    else
        # Anti-flap: only clear activation progress once peers prove stable
        (( stable_count++ )) || true
        if (( stable_count >= ACTIVATE_AFTER )); then
            activate_count=0; stable_count=0
        fi
        if [[ "$current" == "false" ]]; then
            deactivate_count=0
            write_status ""
            continue
        fi
        (( deactivate_count++ )) || true
        if (( deactivate_count >= DEACTIVATE_AFTER )); then
            yielded_for="$(yielded_to)"
            log_info "event=dhcp_deactivate yielded_to=\"$yielded_for\""
            if set_dhcp "false"; then
                remove_vip
                vip_rel=""
                [[ "$VIP_ENABLED" == "true" ]] && vip_rel=" <br> VIP released"
                # Build per-node health for deactivation notification
                detail=""
                for (( _ni=0; _ni<NODE_COUNT; _ni++ )); do
                    _nip="${NODES[$_ni]}"
                    [[ "$_nip" == "$LOCAL_IP" ]] && continue
                    _st=""
                    if [[ "${peer_ping[$_nip]}" == "true" ]]; then _st+="<font color='#3fb950'>ping</font> "; else _st+="<font color='#f85149'>ping</font> "; fi
                    if [[ "${peer_dns[$_nip]}" == "true" ]]; then _st+="<font color='#3fb950'>dns</font> "; else _st+="<font color='#f85149'>dns</font> "; fi
                    if [[ "${peer_api[$_nip]}" == "true" ]]; then _st+="<font color='#3fb950'>api</font> "; else _st+="<font color='#f85149'>api</font> "; fi
                    if [[ "${peer_dhcp[$_nip]}" == "true" ]]; then _st+="<font color='#3fb950'>dhcp</font>"; elif [[ "${peer_dhcp[$_nip]}" == "false" ]]; then _st+="<font color='#d29922'>dhcp:off</font>"; else _st+="<font color='#f85149'>dhcp</font>"; fi
                    detail+=" <br> <font color='#8b949e'>${ROLES[$_ni]}</font> $_nip: $_st"
                done
                NOTIFY_TAG=dhcp_deactivated notify "<b><font color='#f39c12'>$ROLE DHCP DEACTIVATED</font></b> <br> <font color='#95a5a6'>$LOCAL_IP</font> yielding to <b><font color='#2ecc71'>$yielded_for</font></b>${vip_rel}${detail}" &
                log_info "event=dhcp_deactivate status=ok yielded_to=\"$yielded_for\""
            else
                NOTIFY_TAG=dhcp_failover_failed notify "<b><font color='#e74c3c'>$ROLE DHCP DEACTIVATION FAILED</font></b> <br> <font color='#95a5a6'>$LOCAL_IP</font> could not disable DHCP" &
                log_error "event=dhcp_deactivate status=failed"
            fi
            deactivate_count=0
            write_status ""
        else
            log_info "event=dhcp_deactivate_pending count=$deactivate_count/$DEACTIVATE_AFTER"
            write_status "Deactivating ($deactivate_count/$DEACTIVATE_AFTER)"
        fi
    fi
done
